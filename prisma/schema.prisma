model ScraperKuaishouProfile {
  id                 BigInt                          @id @default(autoincrement())
  // eid: định danh trong URL profile (kuaishou.com/profile/{eid}) — dùng để
  // gọi fetch_one_user_v2, không đổi, là key chính để add/lookup channel.
  eid                String                          @unique @db.VarChar(50)
  // user_id: numeric ID — CHỈ fetch_user_hot_post chấp nhận giá trị này (không
  // chấp nhận eid). Resolve được từ fetch_one_user_v2(eid), nullable vì rỗng
  // trong khoảnh khắc ngắn giữa lúc tạo placeholder và lần ingest đồng bộ đầu.
  user_id            String?                         @unique @db.VarChar(50)
  username           String                          @default("") @db.VarChar(255)
  nickname           String                          @default("") @db.VarChar(500)
  url                String                          @db.VarChar(1000)
