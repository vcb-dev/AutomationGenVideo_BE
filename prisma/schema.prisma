// ─────────────────────────────────────────────
//  SOCIAL PUBLISHING (tích hợp từ VCB-tool)
// ─────────────────────────────────────────────

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  THREADS
  YOUTUBE
  ZALO
}

enum SocialPostStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum SocialPostSource {
  IMMEDIATE
  SCHEDULED
}

/// Tài khoản mạng xã hội đã kết nối OAuth (token lưu dạng AES-256 encrypted)
model SocialAccount {
  id                String          @id @default(uuid())
  user_id           String
  platform          SocialPlatform
  platform_id       String
  name              String
  username          String?
  avatar_url        String?
  access_token_enc  String          @db.Text
  refresh_token_enc String?         @db.Text
  token_expires_at  DateTime?
  parent_id         String?
  /// Dữ liệu bổ sung tuỳ platform: { pageId, pageToken, igUserId, channelId, … }
  extra_data        Json?
  is_active         Boolean         @default(true)
  is_shared         Boolean         @default(false)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  user              User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent            SocialAccount?  @relation("AccountHierarchy", fields: [parent_id], references: [id])
  children          SocialAccount[] @relation("AccountHierarchy")
  posts             SocialPost[]

  @@unique([user_id, platform, platform_id])
  @@index([user_id])
  @@index([platform])
  @@index([parent_id])
  @@index([is_active])
  @@index([is_shared])
  @@index([token_expires_at])
  @@index([is_active, token_expires_at])
  @@map("social_accounts")
}

/// Bài đăng: immediate hoặc scheduled (unified model)
model SocialPost {
  id            String           @id @default(uuid())
  user_id       String
  account_id    String
  platform      SocialPlatform
  message       String           @db.Text
  media_urls    String[]         @default([])
  page_id       String?
  privacy       String?          @default("PUBLIC")
  status        SocialPostStatus @default(PENDING)
  source        SocialPostSource @default(IMMEDIATE)
  scheduled_at  DateTime?
  executed_at   DateTime?
  retry_count   Int              @default(0)
  next_retry_at DateTime?
  result        Json?
  error_msg     String?
  thumb_url     String?
  task_id       String?
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  account       SocialAccount    @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  task          Task?            @relation(fields: [task_id], references: [id])

  @@index([user_id])
  @@index([account_id])
  @@index([status])
  @@index([source])
  @@index([scheduled_at])
  @@index([next_retry_at])
  @@index([updated_at])
  @@index([status, scheduled_at])
  @@index([status, source, updated_at])
  @@index([task_id])
  @@map("social_posts")
}

/// OAuth state store (thay thế in-memory Map, tránh mất state khi BE reload)
model SocialOAuthState {
  id              String   @id
  user_id         String
  platform        String
  expires_at      DateTime
  tiktok_verifier String?
  zalo_verifier   String?
  created_at      DateTime @default(now())

  @@index([expires_at])
  @@map("social_oauth_states")
}

