// ────────────────────────────────
//  TASK AUTO-ASSIGNMENT MODULE
// ────────────────────────────────

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AssignmentRunStatus {
  RUNNING
  DONE
  FAILED
}

enum ContentUsageStatus {
  AVAILABLE
  IN_TASK
  USED
  ARCHIVED
}

enum SourceType {
  PRODUCT_STOCK
  COLLECTED
  OUTRO
  WORKSHOP
  HUYK
}

enum KpiAllocationType {
  CONTENT_LINE
  PRODUCT_LINE
}

enum AssignmentOutcome {
  COMPLETED
  OVERDUE
  REASSIGNED
  CANCELLED
}

enum TaskType {
  AUTO
  EXTRA
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BrandType {
  DO_DA
  TRANG_SUC
}

enum TeamKind {
  PRODUCTION
  CONTENT
}

/// Nguồn gốc 1 content do content creator thêm: sưu tầm hay tự nghĩ ra. Content creator tự chọn
/// thủ công khi thêm — không suy luận từ cơ chế tạo (copy từ kho tổng hay tạo mới).
enum ContentOrigin {
  COLLECTED
  SELF_CREATED
}

model Team {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @unique
  leader_id  String?   @db.Uuid
  brand_type BrandType @default(TRANG_SUC)
  market     String    @default("VIETNAM")
  /// PRODUCTION = team sản xuất video (mặc định), CONTENT = team chuyên sưu tầm/dịch content
  team_kind  TeamKind  @default(PRODUCTION)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  leader                     User?                    @relation("TeamLeaderOf", fields: [leader_id], references: [id])
  members                    TeamMember[]
  team_kpis                  TeamKpi[]
  editor_kpis                EditorKpi[]
  editor_daily_kpis          EditorDailyKpi[]
  content_creator_kpis       ContentCreatorKpi[]
  content_creator_daily_kpis ContentCreatorDailyKpi[]
  tasks                      Task[]
  products                   TeamProduct[]
  contents                   TeamContent[]
  team_sources               TeamSource[]
  channels                   Channel[]                @relation("ChannelTeam")
  ordered_sources            Source[]                 @relation("SourceOrderedTeam")
  push_requests              TeamPushRequest[]

  // Content Report relations
  content_videos      ContentVideo[]
  case_studies        CaseStudy[]
  editor_performances EditorPerformance[]
  clone_videos        CloneVideo[]
  action_items        ActionItem[]
  kpi_snapshots       TeamKpiSnapshot[]
  meeting_sessions    MeetingSession[]

  @@index([leader_id])
  @@map("teams")
}

model TeamMember {
  id                 String   @id @default(uuid()) @db.Uuid
  team_id            String   @db.Uuid
  user_id            String   @db.Uuid
  /// Đánh dấu thành viên này là content creator của team (bổ sung cạnh editor, không loại trừ
  /// lẫn nhau, không giới hạn số lượng — chỉ là quy ước nghiệp vụ/UI). Mặc định false cho mọi
  /// dòng hiện có, kể cả thành viên của team_kind=CONTENT.
  is_content_creator Boolean  @default(false)
  joined_at          DateTime @default(now())

  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user User @relation("TeamMembershipOf", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@index([user_id])
  @@map("team_members")
}

model TeamProduct {
