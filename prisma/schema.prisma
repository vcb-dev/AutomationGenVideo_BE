generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")

  // Connection pooling is configured via:
  // 1. DATABASE_URL parameters: connection_limit, pool_timeout
  // 2. PgBouncer (already enabled with pgbouncer=true)
  // 3. Prisma Client pool configuration (see prisma.service.ts)
  // Requirements: 2.5, 8.6 - Pool settings: min=10, max=100, idleTimeoutMillis=30000
  //
  // directUrl dùng connection trực tiếp (port 5432) cho prisma migrate deploy,
  // tránh treo vì PgBouncer transaction mode không hỗ trợ advisory locks.
}

/// Tránh EPERM trên Windows (OneDrive/antivirus khóa file .dll.node) — dùng query-engine .exe
model User {
  id                      String     @id @default(uuid())
  email                   String     @unique
  password_hash           String?
  full_name               String
  google_id               String?    @unique
  manager_id              String?
  is_active               Boolean    @default(true)
  created_at              DateTime   @default(now())
  updated_at              DateTime   @updatedAt
  custom_permissions      String[]   @default([])
  roles                   UserRole[] @default([])
  team                    String?
  team_leader_id          String?
  /// Bitable record id — quáđồng bộ nhân viên từ Lark (trước đây bảng lark_employees)
  lark_employee_record_id String?    @unique
  employee_id             String?    @unique
  image_url               String?
  employee_data           Json?
  /// Chức vụ từ Lark (Member / Leader, …)

  employee_position         String?
  /// Tình trạng Lark: Đang hoạt động / Đã nghỉ
  employee_status           String?
  /// Tháng/ngày từ Lark (cột NGÀY)
  employee_date             DateTime?
  search_histories          SearchHistory[]
  tracked_channels          TrackedChannel[]
  manager                   User?            @relation("ManagerEditors", fields: [manager_id], references: [id])
  editors                   User[]           @relation("ManagerEditors")
  team_leader               User?            @relation("TeamLeaderMembers", fields: [team_leader_id], references: [id])
  team_members              User[]           @relation("TeamLeaderMembers")
  reviewed_duplicates       VideoDuplicate[] @relation("ReviewedDuplicates")
  videos                    Video[]
  social_accounts           SocialAccount[]
  social_posts              SocialPost[]
  teams_leading             Team[]           @relation("TeamLeaderOf")
  team_memberships          TeamMember[]     @relation("TeamMembershipOf")
  editor_approvals          EditorApproval[] @relation("EditorApprovalOf")
  editor_approvals_reviewed EditorApproval[] @relation("EditorApprovalBy")
  team_push_requests          TeamPushRequest[] @relation("TeamPushRequestBy")
  team_push_requests_reviewed TeamPushRequest[] @relation("TeamPushRequestReviewedBy")
  editor_kpis               EditorKpi[]      @relation("EditorKpiOf")
  editor_kpis_set           EditorKpi[]      @relation("EditorKpiSetBy")
  team_kpis_created         TeamKpi[]        @relation("TeamKpiCreatedBy")
  products_added            Product[]        @relation("ProductAddedBy")
  team_products_added       TeamProduct[]    @relation("TeamProductAddedBy")
  team_contents_added       TeamContent[]    @relation("TeamContentAddedBy")
  contents_added            Content[]        @relation("ContentAddedBy")
  sources_added             Source[]         @relation("SourceAddedBy")
  team_sources_added        TeamSource[]     @relation("TeamSourceAddedBy")
  editor_products           EditorProduct[]  @relation("EditorProductOf")
  editor_products_added     EditorProduct[]  @relation("EditorProductAddedBy")
  editor_contents           EditorContent[]  @relation("EditorContentOf")
  editor_contents_added     EditorContent[]  @relation("EditorContentAddedBy")
  editor_sources            EditorSource[]   @relation("EditorSourceOf")
  editor_sources_added      EditorSource[]   @relation("EditorSourceAddedBy")
  tasks_assigned            Task[]           @relation("TaskAssignee")
  tasks_reviewed            Task[]           @relation("TaskReviewer")
  task_assignments          TaskAssignment[] @relation("AssignmentUser")
  notifications             Notification[]   @relation("NotificationOf")
  owned_channels            Channel[]        @relation("ChannelOwnerUser")

  @@index([email])
  @@index([roles])
  @@index([manager_id])
  @@index([team_leader_id])
  @@index([is_active])
  @@index([team])
  @@map("users")
}

model RolePermission {
  id         String   @id @default(uuid())
  role       UserRole @unique
  menu_ids   String[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("role_permissions")
}

model TrackedChannel {
  id                  String      @id @default(uuid())
  user_id             String
  platform            Platform
  username            String
  display_name        String?
  avatar_url          String?
  total_followers     Int?
  total_likes         BigInt      @default(0)
  total_views         BigInt      @default(0)
  total_videos        Int         @default(0)
  engagement_rate     Float       @default(0)
  is_active           Boolean     @default(true)
  last_synced_at      DateTime?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt
  initial_video_count Int         @default(0)
  posts_count         Int?
  /// manual | lark
  added_via           String      @default("manual")
  /// Id bản ghi huyk_channels (Lark) — mỗi dòng Lark tối đa 1 tracked (NULL = nhập tay)
  lark_channel_id     String?     @unique
  user                User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  video_posts         VideoPost[]

  @@unique([user_id, platform, username])
  @@index([user_id])
  @@index([platform])
  @@index([is_active])
  @@index([added_via])
  @@index([user_id, is_active])
  @@index([user_id, platform, is_active])
  @@map("tracked_channels")
}

model Voice {
  id               BigInt   @id @default(autoincrement())
  name             String   @db.VarChar(255)
  voice_id         String   @unique @db.VarChar(255)
  provider         String   @default("heygen") @db.VarChar(50)
  is_cloned        Boolean  @default(false)
  is_system        Boolean  @default(false)
  language         String   @default("vi") @db.VarChar(10)
  gender           String?  @db.VarChar(20)
  sample_audio_url String?
  source_video_id  BigInt?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  @@index([provider])
  @@index([is_cloned])
  @@index([voice_id])
  @@index([provider, is_system])
  @@map("video_management_voice")
}

model Video {
  id            String            @id @default(uuid())
  user_id       String
  title         String?
  description   String?
  thumbnail_url String?
  duration      Int?
  content_hash  String?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  file_url      String?
  duplicate     VideoDuplicate?
  fingerprint   VideoFingerprint?
  posts         VideoPost[]
  user          User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([content_hash])
  @@map("videos")
}

model VideoPost {
  id                String         @id @default(uuid())
  video_id          String
  channel_id        String
  platform          Platform
  platform_video_id String?
  platform_url      String?
  title             String?
  description       String?
  hashtags          String[]       @default([])
  views             BigInt         @default(0)
  likes             BigInt         @default(0)
  comments          Int            @default(0)
  shares            Int            @default(0)
  posted_at         DateTime       @default(now())
  last_synced_at    DateTime?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  channel           TrackedChannel @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  video             Video          @relation(fields: [video_id], references: [id], onDelete: Cascade)

  @@unique([video_id, channel_id])
  @@index([video_id])
  @@index([channel_id])
  @@index([platform])
  @@index([posted_at])
  @@map("video_posts")
}

model VideoFingerprint {
  id               String   @id @default(uuid())
  video_id         String   @unique
  feature_vector   Float[]
  perceptual_hash  String?
  keyframe_hashes  String[] @default([])
  duration_seconds Int
  frame_count      Int?
  resolution       String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  video            Video    @relation(fields: [video_id], references: [id], onDelete: Cascade)

  @@index([video_id])
  @@map("video_fingerprints")
}

model VideoGroup {
  id              String           @id @default(uuid())
  master_video_id String
  production_date DateTime
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  duplicates      VideoDuplicate[]

  @@index([master_video_id])
  @@map("video_groups")
}

model VideoDuplicate {
  id               String          @id @default(uuid())
  group_id         String
  video_id         String          @unique
  status           DuplicateStatus @default(PENDING_REVIEW)
  is_master        Boolean         @default(false)
  similarity_score Float?
  detection_method String?
  confidence_level String?
  reviewed_by      String?
  reviewed_at      DateTime?
  review_note      String?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  group            VideoGroup      @relation(fields: [group_id], references: [id], onDelete: Cascade)
  reviewer         User?           @relation("ReviewedDuplicates", fields: [reviewed_by], references: [id])
  video            Video           @relation(fields: [video_id], references: [id], onDelete: Cascade)

  @@index([group_id])
  @@index([video_id])
  @@index([status])
  @@index([reviewed_by])
  @@map("video_duplicates")
}

