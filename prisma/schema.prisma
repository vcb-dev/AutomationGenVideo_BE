// ─────────────────────────────────────────────
//  CONTENT TRANSFORM (Chuyển đổi kịch bản AI)
// ─────────────────────────────────────────────

/// Nhân vật AI — lưu system_prompt để rewrite kịch bản
model Character {
  id            String   @id @default(uuid())
  name          String   @unique // "HuyK", "Chị Nhạn", "Chung Bùi"...
  slug          String   @unique // "huyk", "chi-nhan", "chung-bui" — dùng làm key ổn định
  description   String?  @db.Text // Mô tả ngắn hiển thị trên UI
  avatar_url    String? // Ảnh đại diện nhân vật
  system_prompt String   @db.Text // Prompt đầy đủ — chỉ BE đọc, không expose FE qua endpoint public (/content-transform/characters); CÓ expose qua endpoint admin CRUD (/characters/*, chỉ ADMIN/MANAGER)
  is_active     Boolean  @default(true) // Ẩn/hiện nhân vật mà không xoá
  order_index   Int      @default(0) // Thứ tự hiển thị trong danh sách
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  updated_by    String?  @db.Uuid // Người sửa gần nhất — FK users.id (uuid, khớp User.id), null nếu chưa từng sửa qua admin CRUD

  histories      ContentTransformHistory[]
  prompt_history CharacterSystemPromptHistory[]
  updatedByUser  User?                          @relation("CharacterUpdatedBy", fields: [updated_by], references: [id])

  @@index([is_active])
  @@index([order_index])
  @@map("characters")
}

/// Lưu lại bản CŨ của system_prompt mỗi khi bị ghi đè qua admin CRUD — để đối chiếu/khôi phục
/// khi cần, tránh lặp lại sự cố mất dữ liệu do sửa prompt thủ công không có lưu vết trước đây.
model CharacterSystemPromptHistory {
  id           String   @id @default(uuid())
  character_id String // Nhân vật bị đổi system_prompt — FK characters.id
  old_content  String   @db.Text // Nội dung system_prompt TRƯỚC lần sửa này (giữ nguyên tuyệt đối, không trim/normalize)
  changed_by   String?  @db.Uuid // Người thực hiện lần sửa — FK users.id (uuid), null nếu không xác định được
  changed_at   DateTime @default(now())

  character     Character @relation(fields: [character_id], references: [id], onDelete: Cascade)
  changedByUser User?     @relation("CharacterSystemPromptHistoryChangedBy", fields: [changed_by], references: [id])

  @@index([character_id])
  @@index([changed_at])
  @@map("character_system_prompt_history")
}

/// Lịch sử mỗi lần chuyển đổi content
model ContentTransformHistory {
  id            String          @id @default(uuid())
  user_id       String          @db.Uuid // User thực hiện — FK sang users.id (uuid)
  character_id  String // Nhân vật được chọn
  input_text    String          @db.Text // Kịch bản gốc user nhập
  output_text   String?         @db.Text // Kết quả AI trả về (null khi lỗi)
  status        TransformStatus @default(PENDING)
  input_type    InputType       @default(TEXT) // Loại dữ liệu đầu vào (TEXT/VIDEO/AUDIO)
  error_message String? // Lý do lỗi nếu status = FAILED
  model_used    String? // Tên model AI ("mock", "gpt-4o", ...)
  duration_ms   Int? // Thời gian xử lý (ms) — monitoring
  /// Kết quả chấm điểm đầy đủ (7 nhóm/23 tiêu chí + hardGateViolations) — xem scoring-criteria.ts
  score_result  Json?
  /// Điểm tổng /100, tách riêng để lọc/sắp xếp mà không cần parse JSON
  overall_score Int?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  user      User      @relation("ContentTransformOf", fields: [user_id], references: [id])
  character Character @relation(fields: [character_id], references: [id])

  @@index([user_id])
  @@index([character_id])
  @@index([status])
  @@index([created_at])
  @@index([user_id, created_at]) // Query lịch sử theo user + phân trang
  @@map("content_transform_histories")
}

enum TransformStatus {
  PENDING // Đang xử lý
  SUCCESS // Thành công
  FAILED // AI lỗi / timeout
}

/// Lịch sử mỗi lần phân tích/nâng cấp content theo khung PAAST
model PaastAnalysisHistory {
  id               String          @id @default(uuid())
  user_id          String          @db.Uuid // User thực hiện — FK sang users.id (uuid)
  input_text       String          @db.Text // Content được phân tích
  status           TransformStatus @default(PENDING)
  analysis_result  Json? // Toàn bộ kết quả phân tích (5 lớp x tiêu chí + cta_warning)
  total_score      Int? // Tổng điểm 0-100, null tới khi status = SUCCESS
  error_message    String? // Lý do lỗi nếu status = FAILED
  model_used       String? // Tên model AI dùng để phân tích
  duration_ms      Int? // Thời gian xử lý (ms) — monitoring
  upgraded_from_id String? // Nếu bản ghi này là kết quả của 1 lần "nâng cấp" — trỏ về bản gốc
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  user          User                   @relation("PaastAnalysisOf", fields: [user_id], references: [id])
  upgraded_from PaastAnalysisHistory?  @relation("PaastUpgradeOf", fields: [upgraded_from_id], references: [id])
  upgrades      PaastAnalysisHistory[] @relation("PaastUpgradeOf")
  video_scripts OwnedVideoScript[]

  @@index([user_id])
  @@index([user_id, created_at]) // Query lịch sử theo user + phân trang
  @@map("paast_analysis_histories")
}

/// Kịch bản của một video kênh nội bộ, dùng để chấm điểm PAAST.
///
/// Vì sao cần bảng riêng: PAAST chấm KỊCH BẢN, mà video cào về chỉ có caption bài đăng —
/// đo trên dữ liệu thật chỉ 9,4% caption đạt mức tối thiểu 100 ký tự, và caption vốn không
/// phải kịch bản. Nguồn dùng được là phụ đề tự sinh của Facebook (~34% video có), lấy một
/// lần rồi lưu ở đây để không phải hỏi lại Graph API mỗi lần mở trang.
///
/// Khoá theo (platform, post_id) chứ KHÔNG theo user: đây là dữ liệu của video, cả team
/// nhìn chung một bản. Điểm PAAST cũng vậy — trỏ qua paast_analysis_id thay vì tra lại bằng
/// findLatestByContent(), vì hàm đó lọc theo user_id nên mỗi người mở lại tốn một lượt LLM.
model OwnedVideoScript {
  id                String  @id @default(uuid())
  platform          String  @db.VarChar(20)
  post_id           String  @db.VarChar(255)
  /// 'phu_de' (phụ đề Facebook) · 'task' (kịch bản gốc từ task-auto) · 'whisper'
  nguon             String  @db.VarChar(20)
  noi_dung          String  @db.Text
  so_ky_tu          Int
  /// Locale của phụ đề, vd 'vi_VN' — khác tiếng Việt thì cần dịch trước khi chấm.
  ngon_ngu          String  @default("") @db.VarChar(20)
  /// Bản chấm PAAST mới nhất của kịch bản này; null nghĩa là có kịch bản nhưng chưa chấm.
  paast_analysis_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  paast_analysis PaastAnalysisHistory? @relation(fields: [paast_analysis_id], references: [id])

  @@unique([platform, post_id])
  @@index([paast_analysis_id])
  @@map("owned_video_scripts")
}

enum InputType {
  TEXT
  VIDEO
  AUDIO
}

// ─────────────────────────────────────────────
//  VÒNG QUAY MAY MẮN — sự kiện nội bộ
//  Dữ liệu dùng chung toàn công ty, mọi người đăng nhập đều xem và thao tác được.
// ─────────────────────────────────────────────

enum SpinEntryStatus {
  ACTIVE // còn trong vòng quay
  DONE // đã trúng, bị loại khỏi các lượt sau cho tới khi đặt lại
}

/// Mỗi vòng quay là một bộ dữ liệu tách biệt (SECI, Đào tạo cán bộ nguồn...) của MỘT tài khoản
model SpinWorkspace {
  id   String @id @default(uuid())
  slug String // "seci" — key ổn định dùng trên URL và FE
  name String

  /// Chủ sở hữu: tài khoản nào đăng nhập thì dùng vòng quay của tài khoản đó, không dùng chung
  /// nữa. Không đặt khoá ngoại sang User, giống created_by_id ở các bảng lịch sử bên dưới.
  owner_id String @db.Uuid

  order_index Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Khóa điều khiển: giữa buổi sự kiện chỉ một người được quay và sửa dữ liệu, những người
  // khác vẫn xem trực tiếp được. Khóa tự hết hạn để không ai bị kẹt khi MC đóng máy.
  //
  // Từ khi mỗi tài khoản có vòng quay riêng thì khóa chỉ có thể do chính chủ giữ, nên nó không
  // còn tác dụng gì. Giữ lại cột thay vì bỏ để khỏi tốn thêm một migration cho thứ vô hại.
  controller_id      String?   @db.Uuid
  controller_name    String?
  control_expires_at DateTime?

  teams       SpinTeam[]
  members     SpinMember[]
  rounds      SpinRound[]
  gifts       SpinGift[]
  member_wins SpinMemberWin[]
  team_wins   SpinTeamWin[]
  gift_awards SpinGiftAward[]

  // Mỗi tài khoản một bản riêng của từng slug: slug một mình không còn là duy nhất.
  @@unique([slug, owner_id])
  @@map("spin_workspaces")
}

model SpinTeam {
  id            String          @id @default(uuid())
  workspace_id  String
  name          String
  status        SpinEntryStatus @default(ACTIVE)
  gift_received Boolean         @default(false)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  workspace SpinWorkspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  members   SpinMember[]
  wins      SpinTeamWin[]
  awards    SpinGiftAward[]

  @@index([workspace_id])
  @@map("spin_teams")
}

model SpinMember {
  id            String          @id @default(uuid())
  workspace_id  String
  team_id       String?
  name          String
  avatar_url    String?
  status        SpinEntryStatus @default(ACTIVE)
  gift_received Boolean         @default(false)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  workspace SpinWorkspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  team      SpinTeam?       @relation(fields: [team_id], references: [id], onDelete: SetNull)
  wins      SpinMemberWin[]
  awards    SpinGiftAward[]

  @@index([workspace_id])
  @@index([team_id])
  @@map("spin_members")
}

model SpinGift {
  id           String   @id @default(uuid())
  workspace_id String
  name         String
  total        Int
  remaining    Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace SpinWorkspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  awards    SpinGiftAward[]

  @@index([workspace_id])
  @@map("spin_gifts")
}

/// Lịch sử thành viên trúng.
/// Tên người và tên team được chụp lại tại thời điểm quay: đổi tên hay xoá thành viên về sau
/// không được phép làm sai lệch biên bản của buổi sự kiện đã diễn ra.
model SpinMemberWin {
  id              String   @id @default(uuid())
  workspace_id    String
  member_id       String? // null khi thành viên đã bị xoá khỏi danh sách
  member_name     String
  team_name       String
  avatar_url      String?
  created_by_id   String?  @db.Uuid // user bấm xác nhận — không đặt FK để khỏi sửa model User
  created_by_name String?
  created_at      DateTime @default(now())

  workspace SpinWorkspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  member    SpinMember?   @relation(fields: [member_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, created_at])
  @@index([member_id])
  @@map("spin_member_wins")
}

model SpinTeamWin {
  id              String   @id @default(uuid())
  workspace_id    String
  team_id         String?
  team_name       String
  created_by_id   String?  @db.Uuid
  created_by_name String?
  created_at      DateTime @default(now())

  workspace SpinWorkspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  team      SpinTeam?     @relation(fields: [team_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, created_at])
  @@map("spin_team_wins")
}

/// Lịch sử quà đã trao — cho cá nhân hoặc cho cả team.
model SpinGiftAward {
  id              String   @id @default(uuid())
  workspace_id    String
  member_id       String? // có giá trị khi trao cho cá nhân
  team_id         String? // có giá trị khi trao cho cả team
  gift_id         String?
  recipient_name  String
  team_name       String
  gift_name       String
  created_by_id   String?  @db.Uuid
  created_by_name String?
  created_at      DateTime @default(now())

  workspace SpinWorkspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  member    SpinMember?   @relation(fields: [member_id], references: [id], onDelete: SetNull)
  team      SpinTeam?     @relation(fields: [team_id], references: [id], onDelete: SetNull)
  gift      SpinGift?     @relation(fields: [gift_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, created_at])
  @@index([member_id])
  @@map("spin_gift_awards")
}

enum SpinRoundKind {
  MEMBER
  TEAM
  GIFT
}

/// Một lượt quay do server bốc.
///
/// Ghi lại nguyên trạng bánh xe tại thời điểm quay (thứ tự ô + chỉ số ô thắng) để hai việc:
/// người thắng không thể bị can thiệp từ trình duyệt, và mọi người đang xem dựng lại được
/// đúng vòng quay đó trên màn hình của họ.
model SpinRound {
  id              String        @id @default(uuid())
  workspace_id    String
  kind            SpinRoundKind
  pool_ids        String[]
  pool_names      String[]
  winner_indexes  Int[]
  recipient_id    String? // vòng quay quà: ai sẽ nhận
  recipient_type  String? // 'member' | 'team'
  started_at      DateTime      @default(now())
  settled_at      DateTime? // đã xác nhận hoặc đã hủy
  created_by_id   String?       @db.Uuid
  created_by_name String?

  workspace SpinWorkspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, started_at])
  @@map("spin_rounds")
}

model OwnedVideoWeeklyNotifyLog {
  id String @id @default(uuid())

  /// Trỏ tới video_management_ownedvideocontent.post_id. KHÔNG đặt quan hệ Prisma vì bảng video
  /// do Django (AI) sở hữu; ràng buộc khoá ngoại ở đây sẽ chặn việc bên kia xoá dọn dữ liệu.
  ///
  /// Unique: một video chỉ được chốt đúng một lần, dù cron chạy lại bao nhiêu lượt.
  post_id String @unique @db.VarChar(255)

  /// open_id người đã nhận. v1 luôn bằng LARK_NOTIFY_OPEN_ID; vẫn lưu vào cột thay vì đọc lại
  /// biến môi trường, vì v2 mỗi video sẽ gửi cho một chủ kênh khác nhau và lúc đó cần biết đã
  /// gửi cho AI để tra khi có người hỏi "sao tôi không nhận được".
  lark_open_id String? @db.VarChar(64)

  /// 'da_gui' · 'khong_co_nguoi_nhan' · 'loi'
  ///
  /// Hai giá trị đầu là CHỐT, truy vấn chọn video loại chúng ra vĩnh viễn. Riêng 'loi' vẫn được
  /// thử lại: một cú rớt mạng không đáng để mất hẳn video khỏi báo cáo.
  trang_thai String @db.VarChar(24)

  /// Số lượt đã thử. Quá 3 thì coi như chốt — lỗi lặp lại 3 lần thì không phải lỗi mạng, thử
  /// tiếp chỉ đốt hạn mức API.
  so_lan_thu Int @default(0)

  loi     String?   @db.Text
  sent_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([trang_thai])
  @@map("owned_video_weekly_notify_log")
}

// ============================================================
// MEMS — Quản lý thiết bị Media. Nguồn: DAC_TA_NGHIEP_VU_MEMS_v1.0.docx
//
// Tên cột đặt tiếng Anh dù tài liệu đặc tả viết tiếng Việt: đây là bảng mới,
// chưa có hợp đồng API nào để giữ, nên theo quy ước hiện hành của repo.
// Bảng đối chiếu tên nằm trong docs/plans/2026-08-10-mems-lat-cat-1-kho-va-kha-dung.md
// ============================================================

enum MemsAssetStatus {
  PENDING_INSPECTION // Chờ kiểm tra — vừa nhập kho, CHƯA cho mượn được (BR-05)
  AVAILABLE // Sẵn sàng
  ON_LOAN // Đang mượn
  POST_RETURN_CHECK // Kiểm tra sau trả — BR-42 bắt buộc đi qua đây, đặc tả thiếu giá trị này
  UNDER_MAINTENANCE // Bảo trì
  BROKEN // Hỏng
  LOST // Mất
  DISPOSED // Đã thanh lý
}

enum MemsAssetCondition {
  GOOD // Tốt
  USED // Có dấu hiệu sử dụng
  NEEDS_CHECK // Cần kiểm tra
  BROKEN // Hỏng
  IN_MAINTENANCE // Bảo trì
}

enum MemsRequestStatus {
  DRAFT // Nháp
  PENDING_APPROVAL // Chờ duyệt
  APPROVED // Đã duyệt
  REJECTED // Từ chối
  CANCELLED // Đã huỷ
  PREPARING // Đang chuẩn bị
  ON_LOAN // Đang mượn
  PARTIALLY_RETURNED // Trả một phần
  CLOSED // Đã đóng
}

enum MemsLineStatus {
  BACKORDERED // Chờ hàng — không giữ chỗ (QĐ-08)
  RESERVED // Đã giữ chỗ
  ALLOCATED // Đã phân bổ máy cụ thể
  ON_LOAN // Đang mượn
  RETURNED // Đã trả
  CANCELLED // Huỷ
}

enum MemsReservationStatus {
  TENTATIVE // Tạm giữ
  CONFIRMED // Đã xác nhận
  RELEASED // Đã nhả — KHÔNG tính vào khả dụng nữa
}

enum MemsRole {
  MEMBER
  APPROVER
  MANAGER
  ADMIN
}

enum MemsApprovalDecision {
  APPROVED
  REJECTED
}

enum MemsIncidentKind {
  CONDITION_WORSENED // Máy tệ đi so với lúc giao
  MISSING_ACCESSORY // Thiếu phụ kiện khi trả
  OVERDUE // Trả trễ
}

enum MemsIncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  WRITTEN_OFF
}

enum MemsAssetEventKind {
  INTAKE // Nhập kho
  HANDED_OVER // Bàn giao cho người mượn
  RETURNED // Người mượn trả về
  INSPECTED // Kiểm tra xong, cho về kệ
  CONDITION_CHANGED
  MAINTENANCE
  INCIDENT
}

model MemsDepartment {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  borrow_limit Int? // Hạn mức thiết bị giữ đồng thời (BR-02). Null = không giới hạn
  is_disabled  Boolean  @default(false) // QĐ-07: không xoá cứng
  created_at   DateTime @default(now())

  members  MemsMember[]
  requests MemsBorrowRequest[]

  @@map("mems_departments")
}

model MemsMember {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @unique @db.Uuid
  department_id String   @db.Uuid
  role          MemsRole @default(MEMBER)
  is_disabled   Boolean  @default(false)
  created_at    DateTime @default(now())

  department MemsDepartment @relation(fields: [department_id], references: [id])

  @@index([department_id])
  @@map("mems_members")
}

model MemsCategory {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  parent_id      String?  @db.Uuid // BR-07: cây chỉ hai cấp
  buffer_minutes Int      @default(0) // BR-12: buffer kiểm tra sau mỗi lượt trả
  is_disabled    Boolean  @default(false)
  created_at     DateTime @default(now())

  parent   MemsCategory?    @relation("MemsCategoryTree", fields: [parent_id], references: [id])
  children MemsCategory[]   @relation("MemsCategoryTree")
  models   MemsAssetModel[]

  @@index([parent_id])
  @@map("mems_categories")
}

model MemsAssetModel {
  id              String   @id @default(uuid()) @db.Uuid
  category_id     String   @db.Uuid
  name            String
  manufacturer    String?
  reference_price Decimal? @db.Decimal(14, 2)
  is_pooled       Boolean  @default(false) // QĐ-04: vật tư quản lý theo số lượng
  is_disabled     Boolean  @default(false)
  created_at      DateTime @default(now())

  category     MemsCategory      @relation(fields: [category_id], references: [id])
  assets       MemsAsset[]
  lines        MemsRequestLine[]
  reservations MemsReservation[]
  accessories  MemsAccessory[]

  @@index([category_id])
  @@map("mems_asset_models")
}

model MemsLocation {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  parent_id   String?  @db.Uuid
  is_disabled Boolean  @default(false)
  created_at  DateTime @default(now())

  parent   MemsLocation?  @relation("MemsLocationTree", fields: [parent_id], references: [id])
  children MemsLocation[] @relation("MemsLocationTree")
  assets   MemsAsset[]

  @@index([parent_id])
  @@map("mems_locations")
}

model MemsAsset {
  id             String             @id @default(uuid()) @db.Uuid
  asset_code     String             @unique // BR-04: duy nhất, không sửa sau khi tạo
  model_id       String             @db.Uuid
  serial_number  String             @unique // BR-04
  condition      MemsAssetCondition @default(GOOD)
  status         MemsAssetStatus    @default(PENDING_INSPECTION) // BR-05
  location_id    String?            @db.Uuid
  purchase_date  DateTime?          @db.Date
  purchase_price Decimal?           @db.Decimal(14, 2)
  qr_code        String             @unique
  is_disabled    Boolean            @default(false)
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  model         MemsAssetModel     @relation(fields: [model_id], references: [id])
  location      MemsLocation?      @relation(fields: [location_id], references: [id])
  reservations  MemsReservation[]
  maintenances  MemsMaintenance[]
  handoverLines MemsHandoverLine[]
  returnLines   MemsReturnLine[]
  incidents     MemsIncident[]
  events        MemsAssetEvent[]
  photos        MemsAssetPhoto[]

  @@index([model_id, status])
  @@map("mems_assets")
}

model MemsBorrowRequest {
  id            String            @id @default(uuid()) @db.Uuid
  request_code  String            @unique // REQ-YYYYMMDD-NNN
  owner_id      String            @db.Uuid // Người chịu trách nhiệm (QĐ-10)
  department_id String            @db.Uuid
  project       String // BR-19: bắt buộc
  place         String
  from_time     DateTime
  to_time       DateTime
  status        MemsRequestStatus @default(DRAFT)
  is_fast_track Boolean           @default(false) // QĐ-05
  note          String?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  department MemsDepartment    @relation(fields: [department_id], references: [id])
  lines      MemsRequestLine[]
  approvals  MemsApproval[]
  handovers  MemsHandover[]
  returns    MemsReturn[]

  @@index([owner_id, status])
  @@map("mems_borrow_requests")
}

model MemsRequestLine {
  id         String         @id @default(uuid()) @db.Uuid
  request_id String         @db.Uuid
  model_id   String         @db.Uuid
  quantity   Int
  status     MemsLineStatus @default(RESERVED)
  note       String?
  created_at DateTime       @default(now())

  request      MemsBorrowRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  model        MemsAssetModel    @relation(fields: [model_id], references: [id])
  reservations MemsReservation[]

  @@index([request_id])
  @@map("mems_request_lines")
}

model MemsReservation {
  id              String                @id @default(uuid()) @db.Uuid
  request_line_id String                @db.Uuid
  model_id        String                @db.Uuid
  asset_id        String?               @db.Uuid // Chỉ điền khi đã ghim máy cụ thể (QĐ-01)
  from_time       DateTime
  to_time         DateTime
  buffer_to_time  DateTime // to_time + buffer của danh mục. Lưu sẵn để đổi tham số không hồi tố
  status          MemsReservationStatus @default(TENTATIVE)
  created_at      DateTime              @default(now())

  request_line MemsRequestLine @relation(fields: [request_line_id], references: [id], onDelete: Cascade)
  model        MemsAssetModel  @relation(fields: [model_id], references: [id])
  asset        MemsAsset?      @relation(fields: [asset_id], references: [id])

  // Truy vấn khả dụng luôn lọc theo model + khoảng thời gian + trạng thái
  @@index([model_id, status, from_time, buffer_to_time])
  @@map("mems_reservations")
}

model MemsMaintenance {
  id         String    @id @default(uuid()) @db.Uuid
  asset_id   String    @db.Uuid
  reason     String
  from_time  DateTime
  to_time    DateTime? // Null = lệnh còn mở, coi như chiếm dụng vô hạn về sau
  cost       Decimal?  @db.Decimal(14, 2)
  created_at DateTime  @default(now())

  asset MemsAsset @relation(fields: [asset_id], references: [id])

  @@index([asset_id, from_time])
  @@map("mems_maintenances")
}

model MemsApproval {
  id         String               @id @default(uuid()) @db.Uuid
  request_id String               @db.Uuid
  level      Int // Cấp 1 hay cấp 2 — BR-22 quyết định phiếu cần mấy cấp
  decision   MemsApprovalDecision
  decided_by String               @db.Uuid
  reason     String? // BR-20: bắt buộc khi từ chối, service chặn chứ không để null lọt qua
  decided_at DateTime             @default(now())

  request MemsBorrowRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)

  // BR-23: bản ghi quyết định chỉ ghi thêm, không sửa không xoá. Không có updated_at là cố ý.
  @@index([request_id, decided_at])
  @@map("mems_approvals")
}

model MemsAccessory {
  id          String  @id @default(uuid()) @db.Uuid
  model_id    String  @db.Uuid
  name        String
  /// Phụ kiện bắt buộc thì thiếu là chặn nhập kho lại, phụ kiện tuỳ chọn chỉ ghi nhận
  is_required Boolean @default(true)
  sort_order  Int     @default(0)

  model         MemsAssetModel          @relation(fields: [model_id], references: [id])
  handoverItems MemsHandoverAccessory[]
  returnItems   MemsReturnAccessory[]

  @@unique([model_id, name])
  @@map("mems_accessories")
}

model MemsHandover {
  id          String   @id @default(uuid()) @db.Uuid
  request_id  String   @db.Uuid
  handed_by   String   @db.Uuid // Người của kho đứng ra giao
  received_by String // Người nhận thực tế, có thể nhận thay nên lưu tên chứ không phải id
  received_at DateTime @default(now())
  note        String?
  created_at  DateTime @default(now())

  request MemsBorrowRequest  @relation(fields: [request_id], references: [id], onDelete: Cascade)
  lines   MemsHandoverLine[]

  @@index([request_id])
  @@map("mems_handovers")
}

model MemsHandoverLine {
  id          String             @id @default(uuid()) @db.Uuid
  handover_id String             @db.Uuid
  asset_id    String             @db.Uuid
  /// Tình trạng lúc giao — mốc để đối chiếu lúc nhận lại (BR-42)
  condition   MemsAssetCondition
  note        String?

  handover    MemsHandover            @relation(fields: [handover_id], references: [id], onDelete: Cascade)
  asset       MemsAsset               @relation(fields: [asset_id], references: [id])
  photos      MemsHandoverPhoto[]
  accessories MemsHandoverAccessory[]
  returnLines MemsReturnLine[]

  @@unique([handover_id, asset_id])
  @@map("mems_handover_lines")
}

model MemsHandoverPhoto {
  id               String   @id @default(uuid()) @db.Uuid
  handover_line_id String   @db.Uuid
  /// Khoá lưu trữ của ảnh. Chưa có endpoint tải ảnh lên nên tạm là chuỗi do client sinh.
  storage_key      String
  taken_at         DateTime @default(now())

  line MemsHandoverLine @relation(fields: [handover_line_id], references: [id], onDelete: Cascade)

  @@index([handover_line_id])
  @@map("mems_handover_photos")
}

model MemsHandoverAccessory {
  id               String  @id @default(uuid()) @db.Uuid
  handover_line_id String  @db.Uuid
  accessory_id     String  @db.Uuid
  is_present       Boolean @default(true)

  line      MemsHandoverLine @relation(fields: [handover_line_id], references: [id], onDelete: Cascade)
  accessory MemsAccessory    @relation(fields: [accessory_id], references: [id])

  @@unique([handover_line_id, accessory_id])
  @@map("mems_handover_accessories")
}

model MemsReturn {
  id          String   @id @default(uuid()) @db.Uuid
  request_id  String   @db.Uuid
  received_by String   @db.Uuid // Người của kho tiếp nhận
  returned_at DateTime @default(now())
  note        String?
  created_at  DateTime @default(now())

  request MemsBorrowRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  lines   MemsReturnLine[]

  // Một phiếu có thể trả nhiều đợt (trả một phần), nên đây là quan hệ một-nhiều
  @@index([request_id])
  @@map("mems_returns")
}

model MemsReturnLine {
  id               String             @id @default(uuid()) @db.Uuid
  return_id        String             @db.Uuid
  asset_id         String             @db.Uuid
  handover_line_id String?            @db.Uuid // Dòng bàn giao tương ứng, để tra lại ảnh lúc giao
  condition_before MemsAssetCondition
  condition_after  MemsAssetCondition
  /// Trạng thái máy sau khi nhận lại — BR-42 chọn giữa AVAILABLE và POST_RETURN_CHECK
  resulting_status MemsAssetStatus
  note             String?

  returnRecord MemsReturn            @relation(fields: [return_id], references: [id], onDelete: Cascade)
  asset        MemsAsset             @relation(fields: [asset_id], references: [id])
  handoverLine MemsHandoverLine?     @relation(fields: [handover_line_id], references: [id])
  photos       MemsReturnPhoto[]
  accessories  MemsReturnAccessory[]
  incidents    MemsIncident[]

  @@unique([return_id, asset_id])
  @@map("mems_return_lines")
}

model MemsReturnPhoto {
  id             String   @id @default(uuid()) @db.Uuid
  return_line_id String   @db.Uuid
  storage_key    String
  taken_at       DateTime @default(now())

  line MemsReturnLine @relation(fields: [return_line_id], references: [id], onDelete: Cascade)

  @@index([return_line_id])
  @@map("mems_return_photos")
}

model MemsReturnAccessory {
  id             String  @id @default(uuid()) @db.Uuid
  return_line_id String  @db.Uuid
  accessory_id   String  @db.Uuid
  is_present     Boolean @default(true)

  line      MemsReturnLine @relation(fields: [return_line_id], references: [id], onDelete: Cascade)
  accessory MemsAccessory  @relation(fields: [accessory_id], references: [id])

  @@unique([return_line_id, accessory_id])
  @@map("mems_return_accessories")
}

model MemsIncident {
  id             String             @id @default(uuid()) @db.Uuid
  asset_id       String             @db.Uuid
  request_id     String?            @db.Uuid
  return_line_id String?            @db.Uuid
  /// Người bị quy trách nhiệm — chính là người chịu trách nhiệm trên phiếu (QĐ-10)
  responsible_id String?            @db.Uuid
  kind           MemsIncidentKind
  description    String
  status         MemsIncidentStatus @default(OPEN)
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  asset      MemsAsset       @relation(fields: [asset_id], references: [id])
  returnLine MemsReturnLine? @relation(fields: [return_line_id], references: [id])

  @@index([asset_id, status])
  @@map("mems_incidents")
}

model MemsAssetEvent {
  id          String             @id @default(uuid()) @db.Uuid
  asset_id    String             @db.Uuid
  kind        MemsAssetEventKind
  title       String
  detail      String?
  actor_id    String?            @db.Uuid
  request_id  String?            @db.Uuid
  occurred_at DateTime           @default(now())

  asset MemsAsset @relation(fields: [asset_id], references: [id])

  // Nhật ký vòng đời chỉ ghi thêm: màn chi tiết máy đọc ngược theo thời gian
  @@index([asset_id, occurred_at])
  @@map("mems_asset_events")
}

model MemsAssetPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  asset_id    String   @db.Uuid
  /// Đường dẫn đầy đủ tới ảnh. Lưu URL chứ không lưu khoá lưu trữ, giống avatar_url và
  /// thumbnail_url ở các bảng khác — nơi lưu có thể đổi mà chỗ đọc không phải sửa gì.
  url         String
  /// google_drive hoặc local, ghi lại để sau này còn biết ảnh nào cần chuyển kho
  storage     String   @default("local")
  caption     String?
  /// Ảnh đại diện hiện ở bảng kho. Mỗi máy chỉ nên có một, service tự bỏ cờ ở ảnh cũ.
  is_primary  Boolean  @default(false)
  sort_order  Int      @default(0)
  uploaded_by String?  @db.Uuid
  created_at  DateTime @default(now())

  asset MemsAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([asset_id, sort_order])
  @@map("mems_asset_photos")
}
