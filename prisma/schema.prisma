model TelegramReportConfig {
  id           String   @id @default(uuid())
  user_id      String   @unique
  user_email   String?
  bot_token    String
  chat_id      String
  schedule     String   @default("0 8 * * *")
  formats      String[] @default(["text"])
  report_types String[] @default(["ads", "traffic"])
  is_active    Boolean  @default(true)
