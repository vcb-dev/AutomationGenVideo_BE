// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  EDITOR
  CONTENT
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password_hash        String?   // Make nullable for Google users
  full_name            String
  avatar               String?   // Add avatar
  google_id            String?   @unique // Add google_id
  role                 UserRole
  manager_id           String?
  is_active            Boolean   @default(true)
  last_login_at        DateTime?
  last_activity_at     DateTime?
  total_login_count    Int       @default(0)
  total_action_count   Int       @default(0)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  // Self-relation: Manager manages Editors
  manager              User?                @relation("ManagerEditors", fields: [manager_id], references: [id], onDelete: SetNull)
  editors              User[]               @relation("ManagerEditors")

  // Relations
  activity_logs        UserActivityLog[]
  usage_stats          UserUsageStat[]
  rate_limits          UserRateLimit[]
  tracked_channels     TrackedChannel[]
  videos               Video[]
  
  // Duplicate detection relations (for managers)
  reviewed_duplicates  VideoDuplicate[]     @relation("ReviewedDuplicates")
  duplicate_reviews    DuplicateReview[]    @relation("DuplicateReviews")

  @@index([email])
  @@index([role])
  @@index([manager_id])
  @@index([last_login_at])
  @@map("users")
}

model UserActivityLog {
  id           String    @id @default(uuid())
  user_id      String
  role         UserRole
  action       String    // login, logout, create_video, delete_video, etc.
  target_type  String?   // video, project, user
  target_id    String?
  description  String?   @db.Text
  ip_address   String?
  user_agent   String?
  metadata     Json?
  created_at   DateTime  @default(now())

  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@index([target_type, target_id])
  @@map("user_activity_logs")
}

model UserUsageStat {
  id                String    @id @default(uuid())
  user_id           String
  date              DateTime  @db.Date
  login_count       Int       @default(0)
  action_count      Int       @default(0)
  video_generated   Int       @default(0)
  api_request_count Int       @default(0)
  last_action_at    DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
  @@index([user_id])
  @@index([date])
  @@map("user_usage_stats")
}

model UserRateLimit {
  id              String    @id @default(uuid())
  user_id         String
  action_type     String    // login, generate_video, api
  max_per_minute  Int       @default(60)
  max_per_day     Int       @default(1000)
  current_count   Int       @default(0)
  window_start    DateTime  @default(now())
  blocked_until   DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, action_type])
  @@index([user_id])
  @@index([action_type])
  @@index([blocked_until])
  @@map("user_rate_limits")
}

enum Platform {
  TIKTOK
  INSTAGRAM
  FACEBOOK
  DOUYIN
  XIAOHONGSHU
}

model TrackedChannel {
  id                String    @id @default(uuid())
  user_id           String
  platform          Platform
  username          String
  display_name      String?
  avatar_url        String?
  total_followers   Int?
  total_likes       BigInt    @default(0)
  total_views       BigInt    @default(0)
  total_videos      Int       @default(0)
  initial_video_count Int     @default(0) // Videos count when channel was first tracked/assigned
  engagement_rate   Float     @default(0)
  is_active         Boolean   @default(true)
  last_synced_at    DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  video_posts       VideoPost[]

  @@unique([user_id, platform, username])
  @@index([user_id])
  @@index([platform])
  @@index([is_active])
  @@map("tracked_channels")
}

// Video: Represents a unique video content created by an editor
model Video {
  id                String      @id @default(uuid())
  user_id           String      // Editor who created this video
  title             String?
  description       String?     @db.Text
  thumbnail_url     String?
  duration          Int?        // Duration in seconds
  file_url          String?     // URL to the original video file
  content_hash      String?     // MD5/SHA256 hash for deduplication
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  user              User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  posts             VideoPost[] // Content deduplication: one video can be posted many times
  
  // Duplicate detection relations
  fingerprint       VideoFingerprint?
  duplicate         VideoDuplicate?
  new_video_reviews DuplicateReview[] @relation("NewVideoReviews")
  suspected_reviews DuplicateReview[] @relation("SuspectedVideoReviews")

  @@index([user_id])
  @@index([content_hash])
  @@map("videos")
}


// VideoPost: Represents a single post of a video to a specific platform/channel
model VideoPost {
  id                String         @id @default(uuid())
  video_id          String         // Link to the unique video
  channel_id        String         // Which channel it was posted to
  platform          Platform       // Platform where it was posted
  
  // Platform-specific data
  platform_video_id String?        // Video ID on the platform (e.g., TikTok video ID)
  platform_url      String?        // Direct URL to the video on platform
  
  // Post metadata
  title             String?
  description       String?        @db.Text
  hashtags          String[]       @default([])
  
  // Stats (synced from platform)
  views             BigInt         @default(0)
  likes             BigInt         @default(0)
  comments          Int            @default(0)
  shares            Int            @default(0)
  
  posted_at         DateTime       @default(now())
  last_synced_at    DateTime?      // Last time stats were synced
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  
  video             Video          @relation(fields: [video_id], references: [id], onDelete: Cascade)
  channel           TrackedChannel @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  
  @@unique([video_id, channel_id]) // Same video can't be posted twice to same channel
  @@index([video_id])
  @@index([channel_id])
  @@index([platform])
  @@index([posted_at])
  @@map("video_posts")
}

// VideoFingerprint: Deep learning fingerprint for duplicate detection
model VideoFingerprint {
  id                String    @id @default(uuid())
  video_id          String    @unique
  
  // Deep learning features (512-dim vector from R(2+1)D model)
  feature_vector    Float[]   // Array of 512 floats
  
  // Perceptual hashes (backup method)
  perceptual_hash   String?   // Combined hash
  keyframe_hashes   String[]  @default([]) // Individual frame hashes
  
  // Metadata
  duration_seconds  Int
  frame_count       Int?
  resolution        String?   // e.g., "1920x1080"
  
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  
  video             Video     @relation(fields: [video_id], references: [id], onDelete: Cascade)
  
  @@index([video_id])
  @@map("video_fingerprints")
}

// VideoGroup: Groups duplicate videos together
model VideoGroup {
  id                String    @id @default(uuid())
  master_video_id   String    // The original/first video
  production_date   DateTime  // When the original video was created
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  
  duplicates        VideoDuplicate[]
  
  @@index([master_video_id])
  @@map("video_groups")
}

enum DuplicateStatus {
  UNIQUE            // Confirmed unique video
  DUPLICATE         // Confirmed duplicate
  PENDING_REVIEW    // Needs manager review
  SUSPICIOUS        // Flagged for review
}

// VideoDuplicate: Tracks duplicate relationships
model VideoDuplicate {
  id                String          @id @default(uuid())
  group_id          String
  video_id          String
  
  status            DuplicateStatus @default(PENDING_REVIEW)
  is_master         Boolean         @default(false) // Is this the original video?
  
  // Detection metadata
  similarity_score  Float?          // 0-1 similarity score
  detection_method  String?         // "deep_learning", "perceptual_hash", "metadata"
  confidence_level  String?         // "high", "medium", "low"
  
  // Review info
  reviewed_by       String?         // Manager user_id
  reviewed_at       DateTime?
  review_note       String?         @db.Text
  
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  
  group             VideoGroup      @relation(fields: [group_id], references: [id], onDelete: Cascade)
  video             Video           @relation(fields: [video_id], references: [id], onDelete: Cascade)
  reviewer          User?           @relation("ReviewedDuplicates", fields: [reviewed_by], references: [id], onDelete: SetNull)
  
  @@unique([video_id]) // Each video can only be in one group
  @@index([group_id])
  @@index([video_id])
  @@index([status])
  @@index([reviewed_by])
  @@map("video_duplicates")
}

// DuplicateReview: Queue for manager to review suspicious duplicates
model DuplicateReview {
  id                    String          @id @default(uuid())
  new_video_id          String          // Video that was just uploaded
  suspected_duplicate_of String         // Video it might be duplicate of
  
  similarity_score      Float           // 0-1 similarity
  detection_method      String          // How it was detected
  confidence_level      String          // "high", "medium", "low"
  
  status                DuplicateStatus @default(PENDING_REVIEW)
  
  // Manager decision
  reviewed_by           String?
  reviewed_at           DateTime?
  decision              String?         // "duplicate", "unique", "skip"
  review_note           String?         @db.Text
  
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt
  
  new_video             Video           @relation("NewVideoReviews", fields: [new_video_id], references: [id], onDelete: Cascade)
  suspected_video       Video           @relation("SuspectedVideoReviews", fields: [suspected_duplicate_of], references: [id], onDelete: Cascade)
  reviewer              User?           @relation("DuplicateReviews", fields: [reviewed_by], references: [id], onDelete: SetNull)
  
  @@index([new_video_id])
  @@index([suspected_duplicate_of])
  @@index([status])
  @@index([reviewed_by])
  @@index([created_at])
  @@map("duplicate_reviews")
}

