  extra_data        Json?
  is_active         Boolean         @default(true)
  is_shared         Boolean         @default(false)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  user              User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent            SocialAccount?  @relation("AccountHierarchy", fields: [parent_id], references: [id])
  children          SocialAccount[] @relation("AccountHierarchy")
  posts             SocialPost[]

  @@unique([user_id, platform, platform_id])
  @@index([user_id])
  @@index([platform])
  @@index([parent_id])
  @@index([is_active])
  @@index([is_shared])
  @@index([token_expires_at])
  @@index([is_active, token_expires_at])
  @@map("social_accounts")
}

/// Bài đăng: immediate hoặc scheduled (unified model)
model SocialPost {
  id            String           @id @default(uuid())
  user_id       String
  account_id    String
  platform      SocialPlatform
  message       String           @db.Text
  media_urls    String[]         @default([])
  page_id       String?
  privacy       String?          @default("PUBLIC")
  status        SocialPostStatus @default(PENDING)
  source        SocialPostSource @default(IMMEDIATE)
  scheduled_at  DateTime?
  executed_at   DateTime?
  retry_count   Int              @default(0)
  next_retry_at DateTime?
  result        Json?
  error_msg     String?
  thumb_url     String?
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  account       SocialAccount    @relation(fields: [account_id], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([account_id])
  @@index([status])
  @@index([source])
  @@index([scheduled_at])
  @@index([next_retry_at])
  @@index([updated_at])
  @@index([status, scheduled_at])
  @@index([status, source, updated_at])
  @@map("social_posts")
}

/// OAuth state store (thay thế in-memory Map, tránh mất state khi BE reload)
model SocialOAuthState {
  id              String   @id
  user_id         String
  platform        String
  expires_at      DateTime
  tiktok_verifier String?
  zalo_verifier   String?
  created_at      DateTime @default(now())

  @@index([expires_at])
  @@map("social_oauth_states")
}

/// Bài nháp
model SocialDraft {
  id         String          @id @default(uuid())
  user_id    String
  title      String?
  message    String          @db.Text
  media_urls String[]        @default([])
  platform   SocialPlatform?
  account_id String?
  page_id    String?
  thumb_url  String?
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt

  @@index([user_id])
  @@map("social_drafts")
}

/// Media Library file metadata only. Binary content is stored in Google Drive.
model SocialUploadedFile {
  id                      String   @id @default(uuid())
  user_id                 String
  filename                String
  originalname            String
  mimetype                String
  size                    Int
  url                     String
  thumbnail_url           String?
  storage                 String   @default("google_drive")
  drive_file_id           String?
  drive_web_view_url      String?
  thumbnail_drive_file_id String?
  created_at              DateTime @default(now())

  @@index([user_id])
  @@index([created_at(sort: Desc)])
  @@map("social_uploaded_files")
}

// ═══════════════════════════════════════════════════════════
