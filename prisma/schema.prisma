  id        String   @id @default(uuid())
  user_id   String
  term      String
  platform  String?
  timestamp DateTime @default(now())

  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([timestamp])
  @@map("search_histories")
}
