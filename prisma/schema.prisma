  is_verified        Boolean   @default(false)
  is_tracked         Boolean   @default(true)
  is_bookmarked      Boolean   @default(false)
  is_owned           Boolean   @default(false)
  is_initial_scraped Boolean   @default(false)
  last_scraped_at    DateTime? @db.Timestamptz(6)
  scraping_status    String    @default("idle") @db.VarChar(20)
  scrape_error       String?   @db.Text
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  videos ScraperXiaohongshuVideo[]

  @@index([is_tracked])
  @@index([is_owned])
  @@index([scraping_status])
  @@map("scraper_xiaohongshu_profiles")
}

// ═══════════════════════════════════════════════════════════
//  YOUTUBE — Channel (Profile) Tracking
// ═══════════════════════════════════════════════════════════

model ScraperYoutubeProfile {
  id                 BigInt                @id @default(autoincrement())
  channel_id         String                @unique @db.VarChar(50)
  title              String                @default("") @db.VarChar(500)
  description        String?               @db.Text
  url                String                @db.VarChar(1000)
  avatar_url         String?               @db.Text
  avatar_drive_url   String                @default("") @db.Text
  banner_url         String?               @db.Text
  banner_drive_url   String                @default("") @db.Text
  is_verified        Boolean               @default(false)
  has_business_email Boolean               @default(false)
  subscriber_count   BigInt                @default(0)
  video_count        Int                   @default(0)
  view_count         BigInt                @default(0)
  country            String                @default("") @db.VarChar(100)
  channel_created_at DateTime?             @db.Timestamptz(6)
  is_tracked         Boolean               @default(false)
  is_bookmarked      Boolean               @default(false)
  is_owned           Boolean               @default(false)
  is_initial_scraped Boolean               @default(false)
  last_scraped_at    DateTime?             @db.Timestamptz(6)
  scraping_status    String                @default("idle") @db.VarChar(20)
  scrape_error       String?               @db.Text
  created_at         DateTime              @default(now()) @db.Timestamptz(6)
  updated_at         DateTime              @updatedAt @db.Timestamptz(6)
  shorts             ScraperYoutubeShort[]

  @@index([title])
  @@index([is_bookmarked])
  @@index([subscriber_count(sort: Desc)])
  @@map("scraper_youtube_profiles")
}

// ═══════════════════════════════════════════════════════════
//  YOUTUBE — Shorts (thuộc 1 channel)
// ═══════════════════════════════════════════════════════════

model ScraperYoutubeShort {
  id                  BigInt                @id @default(autoincrement())
  profile_id          BigInt
  video_id            String                @unique @db.VarChar(20)
  title               String                @default("") @db.Text
  hashtags            String[]              @default([])
  url                 String                @db.VarChar(500)
  thumbnail_url       String?               @db.Text
  thumbnail_drive_url String?               @db.Text
  view_count          BigInt                @default(0)
  view_count_text     String                @default("") @db.VarChar(50)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @updatedAt @db.Timestamptz(6)
  profile             ScraperYoutubeProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id, view_count(sort: Desc)])
  @@index([view_count(sort: Desc)])
  @@map("scraper_youtube_shorts")
}

// ────────────────────────────────
//  TASK AUTO-ASSIGNMENT MODULE
// ────────────────────────────────

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AssignmentRunStatus {
  RUNNING
  DONE
  FAILED
}

enum ContentUsageStatus {
  AVAILABLE
  IN_TASK
  USED
  ARCHIVED
}

enum ContentMarket {
  GLOBAL
  VIETNAM
}

enum SourceType {
  PRODUCT_STOCK
  COLLECTED
  OUTRO
  WORKSHOP
  HUYK
}

enum KpiAllocationType {
  CONTENT_LINE
  PRODUCT_LINE
}

enum AssignmentOutcome {
  COMPLETED
  OVERDUE
  REASSIGNED
  CANCELLED
}

enum TaskType {
  AUTO
  EXTRA
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BrandType {
  DO_DA
  TRANG_SUC
}

model Team {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @unique
  leader_id  String?   @db.Uuid
  brand_type BrandType @default(TRANG_SUC)
  market     String    @default("VIETNAM")
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  leader          User?             @relation("TeamLeaderOf", fields: [leader_id], references: [id])
  members         TeamMember[]
  team_kpis       TeamKpi[]
  editor_kpis     EditorKpi[]
  tasks           Task[]
  products        TeamProduct[]
  contents        TeamContent[]
  team_sources    TeamSource[]
  channels        Channel[]         @relation("ChannelTeam")
  ordered_sources Source[]          @relation("SourceOrderedTeam")
  push_requests   TeamPushRequest[]

  // Content Report relations
  content_videos      ContentVideo[]
  case_studies        CaseStudy[]
  editor_performances EditorPerformance[]
  clone_videos        CloneVideo[]
  action_items        ActionItem[]
  kpi_snapshots       TeamKpiSnapshot[]
  meeting_sessions    MeetingSession[]

  @@index([leader_id])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  team_id   String   @db.Uuid
  user_id   String   @db.Uuid
  joined_at DateTime @default(now())

  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user User @relation("TeamMembershipOf", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@index([user_id])
  @@map("team_members")
}

model TeamProduct {
  id                       String    @id @default(uuid())
  team_id                  String    @db.Uuid
  /// NULL khi được push từ editor (dùng source_editor_product_id để lấy data); có giá trị khi tạo trực tiếp trong team
  sku                      String?
  name                     String?
  brand_type               BrandType @default(DO_DA)
  image_url                String?
  image_urls               String[]  @default([])
  price                    Decimal?  @db.Decimal(15, 2)
  market                   String?
  price_segment            String?
  priority_score           Int       @default(0)
  material_id              String?
  product_line_id          String?
  classification_id        String?
  is_active                Boolean   @default(true)
  /// FK trỏ về EditorProduct khi được push từ kho editor (thay thế copy data)
  source_editor_product_id String?
  /// FK trỏ về Product kho tổng khi được tạo từ global (copy template)
  source_product_id        String?
  added_by_id              String
  added_at                 DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  team                  Team                   @relation(fields: [team_id], references: [id], onDelete: Cascade)
  added_by              User                   @relation("TeamProductAddedBy", fields: [added_by_id], references: [id])
  material              Material?              @relation(fields: [material_id], references: [id])
  product_line          ProductLine?           @relation(fields: [product_line_id], references: [id])
  classification        ProductClassification? @relation(fields: [classification_id], references: [id], onDelete: SetNull)
  source_editor_product EditorProduct?         @relation("TeamProductEditorRef", fields: [source_editor_product_id], references: [id], onDelete: SetNull)
  source_product        Product?               @relation("TeamProductGlobalRef", fields: [source_product_id], references: [id])
  team_sources          TeamSource[]           @relation("TeamProductSources")
  tasks                 Task[]
  warehouses            TeamProductWarehouse[]
  global_product        Product?               @relation("ProductTeamRef")

  @@unique([team_id, source_editor_product_id])
  @@index([team_id, is_active])
  @@map("team_products")
}

model TeamContent {
  id                       String             @id @default(uuid())
  team_id                  String             @db.Uuid
  brand_type               BrandType          @default(DO_DA)
  market                   String             @default("VIETNAM")
  title                    String?
  body                     String?
  script                   String?
  file_content_url         String?
  voice_url                String?
  content_line_id          String?
  classification_id        String?
  status                   ContentUsageStatus @default(AVAILABLE)
  /// FK trỏ về EditorContent khi được push từ kho editor
  source_editor_content_id String?
  /// FK trỏ về Content kho tổng khi được tạo từ global
  source_content_id        String?
  added_by_id              String
  added_at                 DateTime           @default(now())
  updated_at               DateTime           @updatedAt

  team                  Team                   @relation(fields: [team_id], references: [id], onDelete: Cascade)
  added_by              User                   @relation("TeamContentAddedBy", fields: [added_by_id], references: [id])
  content_line          ContentLine?           @relation(fields: [content_line_id], references: [id])
  classification        ContentClassification? @relation(fields: [classification_id], references: [id], onDelete: SetNull)
  source_editor_content EditorContent?         @relation("TeamContentEditorRef", fields: [source_editor_content_id], references: [id], onDelete: SetNull)
  source_content        Content?               @relation("TeamContentGlobalRef", fields: [source_content_id], references: [id])
  tasks                 Task[]
  warehouses            TeamContentWarehouse[]
  global_content        Content?               @relation("ContentTeamRef")

  @@unique([team_id, source_editor_content_id])
  @@map("team_contents")
}

model TeamSource {
  id                      String      @id @default(uuid())
  team_id                 String      @db.Uuid
  brand_type              BrandType   @default(DO_DA)
  /// NULL khi được push từ editor (dùng source_editor_source_id để lấy data); có giá trị khi tạo trực tiếp
  type                    SourceType?
  name                    String?
  link                    String?
  nas_link                String?
  code                    String?
  product_id              String?
  /// Liên kết tới TeamProduct (khi source được tạo cùng lúc với team product)
  team_product_id         String?
  /// FK trỏ về EditorSource khi được push từ kho editor (thay thế copy data)
  source_editor_source_id String?
  /// FK trỏ về Source kho tổng khi được tạo từ global (copy template)
  source_source_id        String?
  added_by_id             String
  is_active               Boolean     @default(true)
  added_at                DateTime    @default(now())
  updated_at              DateTime    @updatedAt

  team                 Team                  @relation(fields: [team_id], references: [id], onDelete: Cascade)
  added_by             User                  @relation("TeamSourceAddedBy", fields: [added_by_id], references: [id])
  product              Product?              @relation(fields: [product_id], references: [id])
  team_product         TeamProduct?          @relation("TeamProductSources", fields: [team_product_id], references: [id], onDelete: SetNull)
  source_editor_source EditorSource?         @relation("TeamSourceEditorRef", fields: [source_editor_source_id], references: [id], onDelete: SetNull)
  source_source        Source?               @relation("TeamSourceGlobalRef", fields: [source_source_id], references: [id])
  warehouses           TeamSourceWarehouse[]
  tasks_as_outro       Task[]                @relation("TaskTeamSourceOutro")
  tasks_as_extra       Task[]                @relation("TaskTeamSourceExtra")
  tasks_as_workshop    Task[]                @relation("TaskTeamSourceWorkshop")
  tasks_as_huyk        Task[]                @relation("TaskTeamSourceHuyk")
  global_source        Source?               @relation("SourceTeamRef")

  @@unique([team_id, source_editor_source_id])
  @@index([team_id, is_active])
  @@index([team_product_id])
  @@map("team_sources")
}

model EditorProduct {
  id                String    @id @default(uuid())
  user_id           String
  sku               String
  name              String
  brand_type        BrandType @default(DO_DA)
  image_url         String?
  image_urls        String[]  @default([])
  price             Decimal?  @db.Decimal(15, 2)
  market            String?
  price_segment     String?
  priority_score    Int       @default(0)
  material_id       String?
  product_line_id   String?
  classification_id String?
  is_active         Boolean   @default(true)
  /// NULL = tạo mới; có giá trị = được copy từ sản phẩm trong kho tổng
  source_product_id String?
  added_by_id       String
  added_at          DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  user           User                     @relation("EditorProductOf", fields: [user_id], references: [id], onDelete: Cascade)
  added_by       User                     @relation("EditorProductAddedBy", fields: [added_by_id], references: [id])
  material       Material?                @relation(fields: [material_id], references: [id])
  product_line   ProductLine?             @relation(fields: [product_line_id], references: [id])
  classification ProductClassification?   @relation(fields: [classification_id], references: [id], onDelete: SetNull)
  source_product Product?                 @relation("EditorProductGlobalRef", fields: [source_product_id], references: [id])
  editor_sources EditorSource[]           @relation("EditorProductSources")
  team_products  TeamProduct[]            @relation("TeamProductEditorRef")
  tasks          Task[]
  warehouses     EditorProductWarehouse[]
  push_requests  TeamPushRequest[]

  @@index([user_id, is_active])
  @@map("editor_products")
}

model EditorContent {
  id                String             @id @default(uuid())
  user_id           String
  brand_type        BrandType          @default(DO_DA)
  market            String             @default("VIETNAM")
  title             String?
  body              String?
  script            String?
  file_content_url  String?
  voice_url         String?
  content_line_id   String?
  classification_id String?
  status            ContentUsageStatus @default(AVAILABLE)
  /// NULL = tạo mới; có giá trị = được copy từ content trong kho tổng
  source_content_id String?
  added_by_id       String
  added_at          DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  user           User                     @relation("EditorContentOf", fields: [user_id], references: [id], onDelete: Cascade)
  added_by       User                     @relation("EditorContentAddedBy", fields: [added_by_id], references: [id])
  content_line   ContentLine?             @relation(fields: [content_line_id], references: [id])
  classification ContentClassification?   @relation(fields: [classification_id], references: [id], onDelete: SetNull)
  source_content Content?                 @relation("EditorContentGlobalRef", fields: [source_content_id], references: [id])
  team_contents  TeamContent[]            @relation("TeamContentEditorRef")
  tasks          Task[]
  warehouses     EditorContentWarehouse[]
  push_requests  TeamPushRequest[]

  @@map("editor_contents")
}

model EditorSource {
  id                String     @id @default(uuid())
  user_id           String
  brand_type        BrandType  @default(DO_DA)
  type              SourceType
  name              String
  link              String
  nas_link          String?
  code              String?
  product_id        String?
  /// Liên kết tới EditorProduct (khi source được tạo cùng lúc với editor product)
  editor_product_id String?
  /// NULL = tạo mới; có giá trị = được copy từ source trong kho tổng
  source_source_id  String?
  added_by_id       String
  is_active         Boolean    @default(true)
  added_at          DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  user              User                    @relation("EditorSourceOf", fields: [user_id], references: [id], onDelete: Cascade)
  added_by          User                    @relation("EditorSourceAddedBy", fields: [added_by_id], references: [id])
  product           Product?                @relation(fields: [product_id], references: [id])
  editor_product    EditorProduct?          @relation("EditorProductSources", fields: [editor_product_id], references: [id], onDelete: SetNull)
  source_source     Source?                 @relation("EditorSourceGlobalRef", fields: [source_source_id], references: [id])
  team_sources      TeamSource[]            @relation("TeamSourceEditorRef")
  warehouses        EditorSourceWarehouse[]
  tasks_as_outro    Task[]                  @relation("TaskEditorSourceOutro")
  tasks_as_extra    Task[]                  @relation("TaskEditorSourceExtra")
  tasks_as_workshop Task[]                  @relation("TaskEditorSourceWorkshop")
  tasks_as_huyk     Task[]                  @relation("TaskEditorSourceHuyk")

  @@index([editor_product_id])
  @@map("editor_sources")
}

enum TeamPushRequestType {
  PRODUCT
  CONTENT
}

enum AttendanceStatus {
  PRESENT // Có mặt
  ABSENT // Vắng mặt (không phép — note optional)
  ON_LEAVE // Nghỉ phép (có phép — note bắt buộc)
  LATE // Đi muộn (do người điểm danh tự chọn thủ công)
}

/// Yêu cầu đẩy product/content từ kho cá nhân → kho team, chờ leader duyệt.
/// Leader/Admin/Manager đẩy thì bỏ qua hàng đợi (đẩy thẳng, không tạo request).
model TeamPushRequest {
  id                String              @id @default(uuid())
  team_id           String              @db.Uuid
  type              TeamPushRequestType
  editor_product_id String?
  editor_content_id String?
  requested_by_id   String
  status            ApprovalStatus      @default(PENDING)
  reviewed_by_id    String?
  reviewed_at       DateTime?
  note              String?
  created_at        DateTime            @default(now())

  team           Team           @relation(fields: [team_id], references: [id], onDelete: Cascade)
  editor_product EditorProduct? @relation(fields: [editor_product_id], references: [id], onDelete: Cascade)
  editor_content EditorContent? @relation(fields: [editor_content_id], references: [id], onDelete: Cascade)
  requested_by   User           @relation("TeamPushRequestBy", fields: [requested_by_id], references: [id], onDelete: Cascade)
  reviewed_by    User?          @relation("TeamPushRequestReviewedBy", fields: [reviewed_by_id], references: [id])

  @@index([team_id, status])
  @@index([requested_by_id])
  @@map("team_push_requests")
}

model EditorApproval {
  id             String         @id @default(uuid()) @db.Uuid
  user_id        String         @db.Uuid
  status         ApprovalStatus @default(PENDING)
  approved_by_id String?        @db.Uuid
  approved_at    DateTime?
  note           String?
  created_at     DateTime       @default(now())

  user        User  @relation("EditorApprovalOf", fields: [user_id], references: [id], onDelete: Cascade)
  approved_by User? @relation("EditorApprovalBy", fields: [approved_by_id], references: [id])

  @@map("editor_approvals")
}

model TeamKpi {
  id            String   @id @default(uuid())
  team_id       String   @db.Uuid
  month         String
  note          String?
  created_by_id String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  team        Team                @relation(fields: [team_id], references: [id], onDelete: Cascade)
  created_by  User                @relation("TeamKpiCreatedBy", fields: [created_by_id], references: [id])
  allocations TeamKpiAllocation[]

  @@unique([team_id, month])
  @@index([month])
  @@map("team_kpis")
}

model TeamKpiAllocation {
  id              String            @id @default(uuid())
  team_kpi_id     String
  type            KpiAllocationType
  content_line_id String?
  product_line_id String?
  percent         Float

  team_kpi     TeamKpi      @relation(fields: [team_kpi_id], references: [id], onDelete: Cascade)
  content_line ContentLine? @relation(fields: [content_line_id], references: [id])
  product_line ProductLine? @relation(fields: [product_line_id], references: [id])

  @@index([team_kpi_id])
  @@index([content_line_id])
  @@index([product_line_id])
  @@map("team_kpi_allocations")
}

model EditorKpi {
  id                  String  @id @default(uuid()) @db.Uuid
  user_id             String  @db.Uuid
  team_id             String? @db.Uuid // null = legacy row trước khi thêm multi-team
  month               String
  // ── Video production (Số video sản xuất đạt tiêu chuẩn) ──
  total_target        Int     @default(0) // = Tổng video sản xuất (drives auto-assign)
  video_win           Int     @default(0) // Số video win (≥10k views)
  video_fail          Int     @default(0) // Số video fail
  // ── Content ──
  kpi_extra           Int     @default(0) // Tổng KPI sáng tạo (chỉ thông báo)
  content_new         Int     @default(0) // Số content mới được làm
  content_collected   Int     @default(0) // Số content sưu tầm về kho team để test
  content_win_cover   Int     @default(0) // Số content win cover lại bởi team
  // ── Product ──
  product_planned     Int     @default(0) // Số SP đẩy video theo kế hoạch
  product_win_collect Int     @default(0) // Số SP sưu tầm và test video win

  set_by_id  String   @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user        User                  @relation("EditorKpiOf", fields: [user_id], references: [id], onDelete: Cascade)
  set_by      User                  @relation("EditorKpiSetBy", fields: [set_by_id], references: [id])
  team        Team?                 @relation(fields: [team_id], references: [id])
  allocations EditorKpiAllocation[]

  @@unique([user_id, team_id, month])
  @@index([month])
  @@index([team_id])
  @@map("editor_kpis")
}

// Phân bổ KPI editor theo ContentLine/ProductLine — thay cho ratio_a1..5/video_traffic/gmv/profit cố định,
// mở rộng được khi thêm dòng nội dung/sản phẩm mới (mirror TeamKpiAllocation)
model EditorKpiAllocation {
  id              String            @id @default(uuid())
  editor_kpi_id   String
  type            KpiAllocationType
  content_line_id String?
  product_line_id String?
  quantity        Int // Số video cụ thể (không phải %) — tổng theo type phải khớp total_target / product_planned

  editor_kpi   EditorKpi    @relation(fields: [editor_kpi_id], references: [id], onDelete: Cascade)
  content_line ContentLine? @relation(fields: [content_line_id], references: [id])
  product_line ProductLine? @relation(fields: [product_line_id], references: [id])

  @@index([editor_kpi_id])
  @@index([content_line_id])
  @@index([product_line_id])
  @@map("editor_kpi_allocations")
}

model ContentLine {
  id     String  @id @default(uuid())
  name   String  @unique
  a_type String?

  contents               Content[]
  team_contents          TeamContent[]
  editor_contents        EditorContent[]
  tasks                  Task[]
  allocations            TeamKpiAllocation[]
  editor_kpi_allocations EditorKpiAllocation[]

  @@map("content_lines")
}

/// Phân loại nghiệp vụ cho content (VD: Content Win, Content Test) — do người dùng
/// tự thêm/xóa, khác với Content.status (ContentUsageStatus - trạng thái vòng đời task).
model ContentClassification {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  contents        Content[]
  team_contents   TeamContent[]
  editor_contents EditorContent[]

  @@map("content_classifications")
}

/// Dòng sản phẩm dùng chung cho mọi brand (không phân biệt đồ da / trang sức)
model ProductLine {
  id             String  @id @default(uuid())
  name           String  @unique
  video_category String?

  products               Product[]
  team_products          TeamProduct[]
  editor_products        EditorProduct[]
  tasks                  Task[]
  allocations            TeamKpiAllocation[]
  editor_kpi_allocations EditorKpiAllocation[]

  @@map("product_lines")
}

model Material {
  id         String    @id @default(uuid())
  name       String
  brand_type BrandType @default(DO_DA)

  products        Product[]
  team_products   TeamProduct[]
  editor_products EditorProduct[]

  @@unique([name, brand_type])
  @@map("materials")
}

/// Phân loại nghiệp vụ cho sản phẩm (VD: Main, Test, Đẩy) — do người dùng tự thêm/xóa,
/// dùng chung mọi brand. Khác với is_active (bật/tắt sản phẩm).
model ProductClassification {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  products        Product[]
  team_products   TeamProduct[]
  editor_products EditorProduct[]

  @@map("product_classifications")
}

model Product {
  id                     String    @id @default(uuid())
  /// NULL khi được push từ team (dùng source_team_product_id để lấy data); có giá trị khi tạo trực tiếp
  sku                    String?   @unique
  name                   String?
  brand_type             BrandType @default(DO_DA)
  image_url              String?
  image_urls             String[]  @default([])
  price                  Decimal?  @db.Decimal(15, 2)
  market                 String?
  price_segment          String?
  priority_score         Int       @default(0)
  material_id            String?
  product_line_id        String?
  classification_id      String?
  added_by_id            String
  lark_record_id         String?   @unique
  is_active              Boolean   @default(true)
  /// FK trỏ về TeamProduct khi được push từ kho team (thay thế copy data)
  source_team_product_id String?   @unique
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  material            Material?              @relation(fields: [material_id], references: [id])
  product_line        ProductLine?           @relation(fields: [product_line_id], references: [id])
  classification      ProductClassification? @relation(fields: [classification_id], references: [id], onDelete: SetNull)
  added_by            User                   @relation("ProductAddedBy", fields: [added_by_id], references: [id])
  source_team_product TeamProduct?           @relation("ProductTeamRef", fields: [source_team_product_id], references: [id], onDelete: SetNull)
  team_versions       TeamProduct[]          @relation("TeamProductGlobalRef")
  editor_versions     EditorProduct[]        @relation("EditorProductGlobalRef")
  sources             Source[]
  team_sources        TeamSource[]
  editor_sources      EditorSource[]
  tasks               Task[]
  warehouses          ProductWarehouse[]

  @@index([product_line_id])
  @@index([classification_id])
  @@index([priority_score(sort: Desc)])
  @@map("products")
}

model Content {
  id                     String             @id @default(uuid())
  brand_type             BrandType          @default(DO_DA)
  market                 ContentMarket      @default(VIETNAM)
  title                  String?
  body                   String?
  script                 String?
  file_content_url       String?
  voice_url              String?
  voice_id               BigInt?
  content_line_id        String?
  classification_id      String?
  status                 ContentUsageStatus @default(AVAILABLE)
  view_count             BigInt             @default(0)
  approved_content_id    String?
  added_by_id            String
  lark_record_id         String?            @unique
  /// FK trỏ về TeamContent khi được push từ kho team (thay thế copy data)
  source_team_content_id String?            @unique
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  content_line        ContentLine?           @relation(fields: [content_line_id], references: [id])
  classification      ContentClassification? @relation(fields: [classification_id], references: [id], onDelete: SetNull)
  added_by            User                   @relation("ContentAddedBy", fields: [added_by_id], references: [id])
  source_team_content TeamContent?           @relation("ContentTeamRef", fields: [source_team_content_id], references: [id], onDelete: SetNull)
  team_versions       TeamContent[]          @relation("TeamContentGlobalRef")
  editor_versions     EditorContent[]        @relation("EditorContentGlobalRef")
  tasks               Task[]
  warehouses          ContentWarehouse[]

  @@index([added_by_id])
  @@index([classification_id])
  @@map("contents")
}

model Source {
  id                    String      @id @default(uuid())
  brand_type            BrandType   @default(DO_DA)
  type                  SourceType?
  name                  String?
  link                  String?
  nas_link              String?
  code                  String?
  product_id            String?
  added_by_id           String
  lark_record_id        String?     @unique
  is_active             Boolean     @default(true)
  /// FK trỏ về TeamSource khi được push từ kho team (thay thế copy data)
  source_team_source_id String?     @unique
  /// Team đã đặt hàng (order) source này khi tạo — hiển thị cột "Team order" ở kho tổng
  ordered_team_id       String?     @db.Uuid
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt

  product            Product?          @relation(fields: [product_id], references: [id])
  added_by           User              @relation("SourceAddedBy", fields: [added_by_id], references: [id])
  source_team_source TeamSource?       @relation("SourceTeamRef", fields: [source_team_source_id], references: [id], onDelete: SetNull)
  ordered_team       Team?             @relation("SourceOrderedTeam", fields: [ordered_team_id], references: [id], onDelete: SetNull)
  team_versions      TeamSource[]      @relation("TeamSourceGlobalRef")
  editor_versions    EditorSource[]    @relation("EditorSourceGlobalRef")
  tasks_outro        Task[]            @relation("TaskSourceOutro")
  tasks_extra        Task[]            @relation("TaskSourceExtra")
  tasks_workshop     Task[]            @relation("TaskSourceWorkshop")
  tasks_huyk         Task[]            @relation("TaskSourceHuyk")
  warehouses         SourceWarehouse[]

  @@index([product_id, is_active])
  @@map("sources")
}

model Task {
  id                        String     @id @default(uuid())
  team_id                   String     @db.Uuid
  content_id                String?
  product_id                String?
  editor_product_id         String?
  team_product_id           String?
  editor_content_id         String?
  team_content_id           String?
  content_line_id           String?
  product_line_id           String?
  source_outro_id           String?
  source_extra_id           String?
  source_workshop_id        String?
  source_huyk_id            String?
  editor_source_outro_id    String?
  editor_source_extra_id    String?
  editor_source_workshop_id String?
  editor_source_huyk_id     String?
  team_source_outro_id      String?
  team_source_extra_id      String?
  team_source_workshop_id   String?
  team_source_huyk_id       String?
  status                    TaskStatus @default(PENDING)
  /// Denormalized từ team.brand_type để tránh JOIN khi filter theo brand
  brand_type                BrandType?
  /// AUTO=đẩy SP theo kế hoạch (lane 1 auto-assign), EXTRA=task sáng tạo (lane 2 auto-assign + tạo tay)
  task_type                 TaskType   @default(EXTRA)
  /// true = task đẩy SP theo kế hoạch (sản phẩm lấy từ kho team)
  is_product_push           Boolean    @default(false)
  assignee_id               String?
  assigned_at               DateTime?
  deadline                  DateTime?
  run_id                    String?
  result_url                String?    @db.Text
  submitted_at              DateTime?
  reviewed_by_id            String?
  reviewed_at               DateTime?
  reject_reason             String?    @db.Text
  lark_record_id            String?    @unique
  created_at                DateTime   @default(now())
  updated_at                DateTime   @updatedAt

  team                   Team              @relation(fields: [team_id], references: [id])
  content                Content?          @relation(fields: [content_id], references: [id])
  product                Product?          @relation(fields: [product_id], references: [id])
  editor_product         EditorProduct?    @relation(fields: [editor_product_id], references: [id])
  team_product           TeamProduct?      @relation(fields: [team_product_id], references: [id])
  editor_content         EditorContent?    @relation(fields: [editor_content_id], references: [id])
  team_content           TeamContent?      @relation(fields: [team_content_id], references: [id])
  content_line           ContentLine?      @relation(fields: [content_line_id], references: [id])
  product_line           ProductLine?      @relation(fields: [product_line_id], references: [id])
  source_outro           Source?           @relation("TaskSourceOutro", fields: [source_outro_id], references: [id])
  source_extra           Source?           @relation("TaskSourceExtra", fields: [source_extra_id], references: [id])
  source_workshop        Source?           @relation("TaskSourceWorkshop", fields: [source_workshop_id], references: [id])
  source_huyk            Source?           @relation("TaskSourceHuyk", fields: [source_huyk_id], references: [id])
  editor_source_outro    EditorSource?     @relation("TaskEditorSourceOutro", fields: [editor_source_outro_id], references: [id])
  editor_source_extra    EditorSource?     @relation("TaskEditorSourceExtra", fields: [editor_source_extra_id], references: [id])
  editor_source_workshop EditorSource?     @relation("TaskEditorSourceWorkshop", fields: [editor_source_workshop_id], references: [id])
  editor_source_huyk     EditorSource?     @relation("TaskEditorSourceHuyk", fields: [editor_source_huyk_id], references: [id])
  team_source_outro      TeamSource?       @relation("TaskTeamSourceOutro", fields: [team_source_outro_id], references: [id])
  team_source_extra      TeamSource?       @relation("TaskTeamSourceExtra", fields: [team_source_extra_id], references: [id])
  team_source_workshop   TeamSource?       @relation("TaskTeamSourceWorkshop", fields: [team_source_workshop_id], references: [id])
  team_source_huyk       TeamSource?       @relation("TaskTeamSourceHuyk", fields: [team_source_huyk_id], references: [id])
  assignee               User?             @relation("TaskAssignee", fields: [assignee_id], references: [id])
  reviewed_by            User?             @relation("TaskReviewer", fields: [reviewed_by_id], references: [id])
  run                    AssignmentRun?    @relation(fields: [run_id], references: [id])
  assignments            TaskAssignment[]
  notifications          Notification[]
  pending_video          TaskPendingVideo?
  video_script           TaskVideoScript?

  @@index([run_id])
  // Dùng bởi editor-eligibility.ts (groupBy assignee+team+assigned_at) và
  // editor-history.ts (dedup theo assignee, push-count theo assignee+team+assigned_at)
  @@index([assignee_id, team_id, assigned_at])
  // ── FK reverse lookups (global warehouse) ──
  @@index([content_id])
  @@index([product_id])
  // ── FK reverse lookups (team/editor scope) ──
  @@index([editor_product_id])
  @@index([team_product_id])
  @@index([editor_content_id])
  @@index([team_content_id])
  @@index([content_line_id])
  @@index([product_line_id])
  @@map("tasks")
}

model TaskVideoScript {
  id          String   @id @default(uuid())
  task_id     String   @unique
  input_hash  String
  content     String   @db.Text
  hashtags    String[]
  translation Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("task_video_scripts")
}

model TaskPendingVideo {
  id            String   @id @default(uuid())
  task_id       String   @unique
  uploader_id   String
  filename      String
  originalname  String
  mimetype      String
  size          BigInt
  url           String
  storage       String   @default("local")
  drive_file_id String?
  web_view_url  String?
  created_at    DateTime @default(now())

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("task_pending_videos")
}

model TaskAssignment {
  id          String             @id @default(uuid())
  task_id     String
  user_id     String
  assigned_at DateTime           @default(now())
  deadline    DateTime
  outcome     AssignmentOutcome?
  run_id      String?
  note        String?

  task Task           @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user User           @relation("AssignmentUser", fields: [user_id], references: [id])
  run  AssignmentRun? @relation(fields: [run_id], references: [id])

  @@index([task_id])
  @@index([user_id, assigned_at])
  @@index([run_id])
  @@map("task_assignments")
}

model AssignmentRun {
  id             String              @id @default(uuid())
  run_at         DateTime            @default(now())
  status         AssignmentRunStatus @default(RUNNING)
  total_assigned Int                 @default(0)
  total_skipped  Int                 @default(0)
  details        Json?
  error_msg      String?
  finished_at    DateTime?

  tasks       Task[]
  assignments TaskAssignment[]

  @@index([run_at(sort: Desc)])
  @@map("assignment_runs")
}

model AutoAssignSetting {
  id              Int      @id @default(1)
  schedule_time   String   @default("17:00")
  timezone        String   @default("Asia/Ho_Chi_Minh")
  weekend_enabled Boolean  @default(true)
  is_active       Boolean  @default(true)
  updated_by      String?
  updated_at      DateTime @updatedAt

  @@map("auto_assign_settings")
}

model Notification {
  id         String    @id @default(uuid())
  user_id    String
  type       String
  title      String
  body       String?
  task_id    String?
  is_read    Boolean   @default(false)
  /// Dùng cho cron cleanup — NULL = không tự xóa, có giá trị = xóa sau ngày này
  expires_at DateTime?
  created_at DateTime  @default(now())

  user User  @relation("NotificationOf", fields: [user_id], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [task_id], references: [id], onDelete: SetNull)

  @@index([user_id, is_read])
  @@index([user_id, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@index([expires_at])
  @@map("notifications")
}

model SocialDriveUploadSession {
  id             String    @id
  user_id        String
  filename       String
  originalname   String
  mimetype       String
  size           Int
  upload_url     String    @db.Text
  drive_file_id  String?
  uploaded_bytes Int       @default(0)
  status         String    @default("PENDING")
  error_msg      String?
  expires_at     DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([user_id])
  @@index([created_at(sort: Desc)])
  @@map("social_drive_upload_sessions")
}

//  CONTENT REPORT — Module "Báo cáo content"
// ─────────────────────────────────────────────

/// Kỳ báo cáo — tuần hoặc tháng
model ReportPeriod {
  id         String     @id @default(uuid())
  type       PeriodType // WEEK | MONTH
  label      String // "Tuần 1 - T6/2026", "Tháng 6/2026"
  start_date DateTime
  end_date   DateTime
  created_at DateTime   @default(now())

  // Relations
  content_videos      ContentVideo[]
  case_studies        CaseStudy[]
  editor_performances EditorPerformance[]
  clone_videos        CloneVideo[]
  action_items        ActionItem[]
  kpi_snapshots       TeamKpiSnapshot[]
  meeting_sessions    MeetingSession[]

  @@unique([type, start_date])
  @@index([type])
  @@index([start_date])
  @@map("report_periods")
}

/// Video content WIN hoặc FAIL của team
model ContentVideo {
  id             String      @id @default(uuid())
  team_id        String
  period_id      String
  editor_id      String
  status         VideoStatus // WIN | FAIL
  content        String      @db.Text
  analysis       String?     @db.Text // Phân tích win/fail reason
  link           String?
  platform       String? // TikTok, YouTube Shorts, IG Reels
  post_date      DateTime?
  views          BigInt      @default(0)
  likes          BigInt      @default(0)
  comments       Int         @default(0)
  shares         Int         @default(0)
  thumbnail_url  String?
  video_url      String?
  highlights     String?     @db.Text
  improvements   String?     @db.Text
  leader_comment String?     @db.Text
  notes          String?     @db.Text
  order_index    Int         @default(0)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  team   Team         @relation(fields: [team_id], references: [id])
  period ReportPeriod @relation(fields: [period_id], references: [id])
  editor User         @relation("EditorContentVideos", fields: [editor_id], references: [id])
  scores VideoScore[]

  @@index([team_id, period_id, status])
  @@index([editor_id])
  @@index([period_id])
  @@map("content_videos")
}

/// Case study hay bên ngoài
model CaseStudy {
  id          String    @id @default(uuid())
  team_id     String
  period_id   String
  created_by  String // FK → users (người tạo)
  title       String
  channel     String? // Tên kênh bên ngoài
  content     String?   @db.Text
  takeaway    String?   @db.Text // Bài học rút ra
  link        String?
  platform    String?
  post_date   DateTime?
  views       BigInt    @default(0)
  order_index Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  team    Team         @relation(fields: [team_id], references: [id])
  period  ReportPeriod @relation(fields: [period_id], references: [id])
  creator User         @relation("CreatorCaseStudies", fields: [created_by], references: [id])

  @@index([team_id, period_id])
  @@index([created_by])
  @@map("case_studies")
}

/// Hiệu suất cá nhân editor trong kỳ
model EditorPerformance {
  id           String   @id @default(uuid())
  team_id      String
  period_id    String
  user_id      String // FK → users (editor)
  total_videos Int      @default(0)
  win_videos   Int      @default(0)
  notes        String?  @db.Text
  analysis     String?  @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  team   Team         @relation(fields: [team_id], references: [id])
  period ReportPeriod @relation(fields: [period_id], references: [id])
  user   User         @relation(fields: [user_id], references: [id])

  @@unique([team_id, period_id, user_id]) // 1 editor chỉ có 1 record / kỳ / team
  @@map("editor_performance")
}

/// Video nhân bản (clone)
model CloneVideo {
  id             String    @id @default(uuid())
  team_id        String
  period_id      String
  editor_id      String
  content        String    @db.Text
  target_channel String?
  link           String?
  platform       String?
  post_date      DateTime?
  views          BigInt    @default(0)
  likes          BigInt    @default(0)
  comments       Int       @default(0)
  shares         Int       @default(0)
  analysis       String?   @db.Text
  highlights     String?   @db.Text
  improvements   String?   @db.Text
  leader_comment String?   @db.Text
  notes          String?   @db.Text
  video_url      String?
  order_index    Int       @default(0)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  team   Team         @relation(fields: [team_id], references: [id])
  period ReportPeriod @relation(fields: [period_id], references: [id])
  editor User         @relation("EditorCloneVideos", fields: [editor_id], references: [id])

  @@index([team_id, period_id])
  @@index([editor_id])
  @@map("clone_videos")
}

/// Kế hoạch hành động sau khi phân tích
model ActionItem {
  id             String    @id @default(uuid())
  team_id        String
  period_id      String
  assignee_id    String // FK → users (người được giao)
  title          String
  description    String?   @db.Text
  deadline       DateTime?
  status         String    @default("PENDING") // PENDING, IN_PROGRESS, DONE
  priority       String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  notes          String?   @db.Text
  leader_comment String?   @db.Text
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  team     Team         @relation(fields: [team_id], references: [id])
  period   ReportPeriod @relation(fields: [period_id], references: [id])
  assignee User         @relation("AssigneeActionItems", fields: [assignee_id], references: [id])

  @@index([team_id, period_id])
  @@index([assignee_id])
  @@map("action_items")
}

/// Ảnh chụp nhanh KPI tổng hợp — cache để FE load nhanh
model TeamKpiSnapshot {
  id               String   @id @default(uuid())
  team_id          String
  period_id        String
  total_videos     Int      @default(0)
  win_videos       Int      @default(0)
  fail_videos      Int      @default(0)
  win_rate         Float    @default(0)
  total_new_videos Int      @default(0)
  new_win_videos   Int      @default(0)
  new_win_rate     Float    @default(0)
  computed_at      DateTime @default(now())

  team   Team         @relation(fields: [team_id], references: [id])
  period ReportPeriod @relation(fields: [period_id], references: [id])

  @@unique([team_id, period_id]) // 1 snapshot / team / kỳ
  @@map("team_kpi_snapshots")
}

model VideoScore {
  id               String @id @default(uuid())
  content_video_id String
  scored_by_id     String

  score_hook      Float
  score_content   Float
  score_editing   Float
  score_cta       Float
  score_thumbnail Float
  score_total     Float

  comment    String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  content_video ContentVideo @relation(fields: [content_video_id], references: [id], onDelete: Cascade)
  scored_by     User         @relation("UserVideoScores", fields: [scored_by_id], references: [id], onDelete: Cascade)

  @@unique([content_video_id, scored_by_id])
  @@map("video_scores")
}

//  WAREHOUSE JUNCTION TABLES (kho tháng)
// ─────────────────────────────────────────────

model ProductWarehouse {
  product_id String
  month      String

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([product_id, month])
  @@index([month])
  @@map("product_warehouses")
}

model ContentWarehouse {
  content_id String
  month      String

  content Content @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@id([content_id, month])
  @@index([month])
  @@map("content_warehouses")
}

model SourceWarehouse {
  source_id String
  month     String

  source Source @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@id([source_id, month])
  @@index([month])
  @@map("source_warehouses")
}

model TeamProductWarehouse {
  team_product_id String
  month           String

  team_product TeamProduct @relation(fields: [team_product_id], references: [id], onDelete: Cascade)

  @@id([team_product_id, month])
  @@index([month])
  @@map("team_product_warehouses")
}

model TeamContentWarehouse {
  team_content_id String
  month           String

  team_content TeamContent @relation(fields: [team_content_id], references: [id], onDelete: Cascade)

  @@id([team_content_id, month])
  @@index([month])
  @@map("team_content_warehouses")
}

model TeamSourceWarehouse {
  team_source_id String
  month          String

  team_source TeamSource @relation(fields: [team_source_id], references: [id], onDelete: Cascade)

  @@id([team_source_id, month])
  @@index([month])
  @@map("team_source_warehouses")
}

model EditorProductWarehouse {
  editor_product_id String
  month             String

  editor_product EditorProduct @relation(fields: [editor_product_id], references: [id], onDelete: Cascade)

  @@id([editor_product_id, month])
  @@index([month])
  @@map("editor_product_warehouses")
}

model EditorContentWarehouse {
  editor_content_id String
  month             String

  editor_content EditorContent @relation(fields: [editor_content_id], references: [id], onDelete: Cascade)

  @@id([editor_content_id, month])
  @@index([month])
  @@map("editor_content_warehouses")
}

model EditorSourceWarehouse {
  editor_source_id String
  month            String

  editor_source EditorSource @relation(fields: [editor_source_id], references: [id], onDelete: Cascade)

  @@id([editor_source_id, month])
  @@index([month])
  @@map("editor_source_warehouses")
}

// ─────────────────────────────────────────────
//  ATTENDANCE (Điểm danh buổi họp tuần)
// ─────────────────────────────────────────────

/// Buổi họp team định kỳ hàng tuần
model MeetingSession {
  id              String    @id @default(uuid())
  team_id         String
  period_id       String // FK → ReportPeriod (type = WEEK)
  title           String? // "Họp tuần 1 - T7/2026" — optional label
  scheduled_at    DateTime // Mốc giờ họp — chỉ hiển thị/tham khảo, không tự tính LATE
  notes           String?   @db.Text
  created_by      String // FK → users (người tạo)
  is_finalized    Boolean   @default(false)
  finalized_at    DateTime?
  finalized_by_id String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  team         Team                @relation(fields: [team_id], references: [id])
  period       ReportPeriod        @relation(fields: [period_id], references: [id])
  creator      User                @relation("MeetingSessionCreator", fields: [created_by], references: [id])
  finalized_by User?               @relation("MeetingSessionFinalizer", fields: [finalized_by_id], references: [id])
  attendances  AttendanceRecord[]
  logs         MeetingSessionLog[]

  @@unique([team_id, period_id]) // 1 session / team / kỳ tuần → key upsert
  @@index([team_id])
  @@index([period_id])
  @@map("meeting_sessions")
}

/// Điểm danh từng thành viên cho 1 buổi họp
model AttendanceRecord {
  id           String           @id @default(uuid())
  session_id   String
  user_id      String // Thành viên được điểm danh
  status       AttendanceStatus @default(PRESENT)
  note         String?          @db.Text // Bắt buộc khi ON_LEAVE (enforce ở DTO/service)
  marked_by_id String // Người thực hiện điểm danh (self hoặc manager)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  session   MeetingSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user      User           @relation("AttendanceOf", fields: [user_id], references: [id])
  marked_by User           @relation("AttendanceMarkedBy", fields: [marked_by_id], references: [id])

  @@unique([session_id, user_id]) // 1 bản ghi / người / buổi → basis upsert
  @@index([user_id])
  @@index([session_id])
  @@map("attendance_records")
}

model MeetingSessionLog {
  id         String   @id @default(uuid())
  session_id String
  actor_id   String
  action     String // "FINALIZE" | "REOPEN"
  created_at DateTime @default(now())

  session MeetingSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  actor   User           @relation("MeetingLogActor", fields: [actor_id], references: [id])

  @@index([session_id])
  @@map("meeting_session_logs")
}

/// Phiên chat với VCB Assistant
model ChatConversation {
  id               String        @id @default(uuid())
  user_id          String
  telegram_chat_id String? // Telegram chat_id nếu đến từ bot
  title            String
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  user             User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages         ChatMessage[]

  @@index([user_id])
  @@index([user_id, updated_at])
  @@index([telegram_chat_id])
  @@map("chat_conversations")
}

/// Tin nhắn trong phiên chat VCB Assistant
model ChatMessage {
  id              String           @id @default(uuid())
  conversation_id String
  role            String // "user" | "assistant"
  content         String           @db.Text
  dashboard       Json? // structured dashboard JSON từ AI
  created_at      DateTime         @default(now())
  conversation    ChatConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([conversation_id, created_at])
  @@map("chat_messages")
}

/// Stats từng campaign quảng cáo Facebook — sync 1 lần/ngày
model AdsCampaignStats {
  id                  String   @id @default(uuid())
  platform            String   @default("meta") // meta | tiktok
  account_id          String
  account_name        String?
  campaign_id         String
  campaign_name       String
  team                String? // Team K1, K2, Đồ da...
  owner               String? // Việt, Nhạn...
  camp_type           String? // mess | like_page | tuong_tac
  content_type        String? // A1 | A2 | A3 | A4 | A5
  spend               Float    @default(0)
  impressions         BigInt   @default(0)
  reach               BigInt   @default(0)
  mess_count          Int      @default(0)
  cost_per_mess       Float    @default(0)
  like_count          Int      @default(0)
  cost_per_like       Float    @default(0)
  comment_count       Int      @default(0)
  share_count         Int      @default(0)
  engagement_count    Int      @default(0)
  cost_per_engagement Float    @default(0)
  clicks              Int      @default(0)
  date_start          String
  date_stop           String
  year                Int
  month               Int
  synced_at           DateTime @default(now()) @updatedAt

  @@unique([campaign_id, date_start, date_stop])
  @@index([year, month])
  @@index([camp_type, year, month])
  @@index([content_type, year, month])
  @@map("ads_campaign_stats")
}

/// Dữ liệu từng video/post theo kênh — YouTube, Facebook, Instagram
model SocialVideoReport {
  id           String    @id @default(uuid())
  platform     String // youtube | facebook | instagram
  post_id      String
  channel_name String
  username     String
  owner        String?
  team         String?
  title        String?   @db.Text
  hashtags     String[]  @default([])
  views        BigInt    @default(0)
  likes        BigInt    @default(0)
  comments     BigInt    @default(0)
  shares       BigInt    @default(0)
  followers    BigInt    @default(0)
  video_url    String?
  published_at DateTime?
  year         Int
  month        Int
  source       String    @default("api") // api | apify
  synced_at    DateTime  @default(now()) @updatedAt
  is_active    Boolean   @default(true) // false = video bị xóa khỏi platform
  deleted_at   DateTime? // thời điểm phát hiện bị xóa

  @@unique([platform, post_id])
  @@index([platform, year, month])
  @@index([username, year, month])
  @@index([team, year, month])
  @@index([year, month])
  @@map("social_video_report")
}

model BusinessChannelConnection {
  id              String    @id @default(uuid())
  channel_name    String
  platform_id     String
  platform        String
  connection_type String    @default("Kênh nội dung")
  sync_status     String    @default("Chưa đồng bộ")
  last_sync_at    DateTime?
  creator_email   String?
  is_active       Boolean   @default(true)
  avatar_url      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([platform_id, platform])
  @@index([platform])
  @@index([sync_status])
  @@map("business_channel_connections")
}

model TelegramReportConfig {
  id           String   @id @default(uuid())
  user_id      String   @unique
  user_email   String?
  bot_token    String
  chat_id      String
  schedule     String   @default("0 8 * * *")
  formats      String[] @default(["text"])
  report_types String[] @default(["ads", "traffic"])
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([user_email])
  @@map("telegram_report_config")
}
