  keyword    ScraperSearchKeyword @relation(fields: [keyword_id], references: [id], onDelete: Cascade)

  @@unique([fanpage_id, keyword_id])
  @@map("scraper_fanpage_keywords")
}

model ScraperFanpageMetrics {
