  following_count    BigInt                          @default(0)
  likes_count        BigInt                          @default(0)
  videos_count       Int                             @default(0)
  is_tracked         Boolean                         @default(false)
  is_bookmarked      Boolean                         @default(false)
  is_initial_scraped Boolean                         @default(false)
  last_scraped_at    DateTime?                       @db.Timestamptz(6)
  scraping_status    String                          @default("idle") @db.VarChar(20)
  scrape_error       String?                         @db.Text
  created_at         DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                        @updatedAt @db.Timestamptz(6)
  videos             ScraperKuaishouVideo[]
  metrics_history    ScraperKuaishouProfileMetrics[]

  @@index([username])
  @@index([is_tracked, last_scraped_at])
  @@index([is_bookmarked])
  @@index([followers_count(sort: Desc)])
  @@map("scraper_kuaishou_profiles")
