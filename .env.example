# Environment
NODE_ENV=development
PORT=3000

# Database (Supabase PgBouncer 6543: set DB_POOL_SIZE=5 max per Cloud Run instance)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
# DB_POOL_SIZE=5

# JWT Configuration
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN="http://localhost:3001"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
FRONTEND_URL="http://localhost:3001"

# AI Service Integration
AI_SERVICE_URL="http://localhost:8001"

# Search Service (Meilisearch)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="masterKey"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Lark Suite Configuration
LARK_APP_ID="your-lark-app-id"
LARK_APP_SECRET="your-lark-app-secret"

# Lark Bitable - Report Table
LARK_REPORT_BASE_ID="your-report-base-id"
LARK_REPORT_TABLE_ID="your-report-table-id"

# Lark Bitable - KPI & Employee Tables
LARK_KPI_BASE_ID="your-kpi-base-id"
LARK_KPI_TABLE_ID="your-kpi-table-id"
# KPI hiệu suất Đồ Da (wiki Bitable — mặc định trong code nếu để trống)
LARK_KPI_DODA_BASE_ID=""
LARK_KPI_DODA_TABLE_ID=""
LARK_EMPLOYEE_TABLE_ID="your-employee-table-id"
`