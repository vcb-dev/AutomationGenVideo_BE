# Environment
NODE_ENV=development
PORT=3000

# Database (Supabase PgBouncer 6543: set DB_POOL_SIZE=5 max per Cloud Run instance)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
DIRECT_DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
# DB_POOL_SIZE=5

# Supabase Production DB (server) - chỉ bật khi cần connect thẳng lên server
# SERVER_DATABASE_URL="postgresql://user:pass@your-pooler-host:6543/postgres?pgbouncer=true&connection_limit=100&pool_timeout=30"
# DIRECT_DATABASE_URL="postgresql://user:pass@your-pooler-host:5432/postgres?connection_limit=5"
# LARK_KPI_MIRROR_TO_SERVER=true

# JWT Configuration
JWT_SECRET="your-secret-key-here"
# --- Auth cookie ---
# Hạn access/refresh token. THAY HOÀN TOÀN JWT_EXPIRES_IN cũ — biến đó không còn được đọc ở đâu
# nữa. Sai định dạng (ví dụ "15x") thì âm thầm dùng mặc định 15 phút, không báo lỗi.
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
# Production PHẢI đặt true, nếu không cookie đi qua HTTP trần.
COOKIE_SECURE="false"
# Safari chặn cookie SameSite=None (third-party) rất mạnh. Để lax chạy được trên Safari, FE và API
# phải CÙNG SITE: proxy /api qua Vercel (www.vcbi.vn/api) hoặc subdomain api.vcbi.vn.
# Gọi thẳng *.up.railway.app từ www.vcbi.vn là cross-site — lax sẽ KHÔNG gửi cookie.
COOKIE_SAMESITE="lax"
# Chỉ đặt khi API là subdomain, ví dụ api.vcbi.vn → ".vcbi.vn". Để rỗng nếu API same-origin (proxy Vercel).
COOKIE_DOMAIN=""

# CORS
CORS_ORIGIN="http://localhost:3001"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Production (Safari + SameSite=lax, proxy Vercel): https://www.vcbi.vn/api/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
FRONTEND_URL="http://localhost:3001"

# AI Service Integration
# BẮT BUỘC — không còn giá trị mặc định trong mã nguồn. Trước đây 24 chỗ tự đặt mặc định
# riêng, 8 chỗ dùng cổng 8001 và 16 chỗ dùng 8000, nên thiếu biến này thì một nửa module gọi
# đúng còn nửa kia gọi vào chỗ không ai nghe.
#   chạy local theo start-all.sh: http://localhost:8001
#   bản Docker (Dockerfile đặt PORT=8000): http://localhost:8000
AI_SERVICE_URL="http://localhost:8001"

# Video Storage
VIDEO_STORAGE_PATH="./storage/videos"

# Search Service (Meilisearch) — hiện KHÔNG có code nào trong repo BE đọc 2 biến này (đã grep xong).
# Giữ lại theo .env.example cũ phòng khi tính năng search được nối dây; bật lại nếu cần.
# MEILISEARCH_HOST="http://localhost:7700"
# MEILISEARCH_API_KEY="masterKey"

# Lark Suite Configuration
LARK_APP_ID="your-lark-app-id"
LARK_APP_SECRET="your-lark-app-secret"

# Lark Bitable - Report Table
LARK_REPORT_BASE_ID="your-report-base-id"
LARK_REPORT_TABLE_ID="your-report-table-id"

# Lark Bitable - KPI & Employee Tables
LARK_KPI_BASE_ID="your-kpi-base-id"
LARK_KPI_TABLE_ID="your-kpi-table-id"
LARK_EMPLOYEE_TABLE_ID="your-employee-table-id"
LARK_PERMISSION_TABLE_ID="your-permission-table-id"
LARK_TRAFFIC_TABLE_ID="your-traffic-table-id"
LARK_QLTASK_BASE_ID="your-qltask-base-id"
LARK_VCB_HR_BASE_ID="your-vcb-hr-base-id"
LARK_OUTSTANDING_TABLE_ID="your-outstanding-table-id"
LARK_BASE_APP_TOKEN="your-base-app-token"
LARK_BASE_TABLE_ID="your-base-table-id"
LARK_HUYK_BASE_ID="your-huyk-base-id"
# Mặc định tự tính March 1st của năm hiện tại. Bỏ comment nếu muốn override thủ công.
# LARK_KPI_MIN_DATE=2026-03-01
# LARK_KPI_DODA_MIN_DATE=2026-04-01

# KPI hiệu suất Đồ Da (wiki Bitable — mặc định trong code nếu để trống)
# KPI Do Da bot + bitable
LARK_KPI_DODA_APP_ID=""
LARK_KPI_DODA_APP_SECRET=""
LARK_KPI_DODA_BASE_ID=""
LARK_KPI_DODA_TABLE_ID=""
# KPI Global Indo - External wiki space, phai dung OAuth user token
LARK_KPI_GLOBAL_INDO_APP_ID=""
LARK_KPI_GLOBAL_INDO_APP_SECRET=""
LARK_KPI_GLOBAL_INDO_BASE_ID=""
LARK_KPI_GLOBAL_INDO_TABLE_ID=""
LARK_KPI_GLOBAL_INDO_REPORT_TABLE_ID=""
# Lay bang cach chay: npx ts-node scripts/lark-auth-global-indo.ts (tu gia han moi lan sync)
LARK_KPI_GLOBAL_INDO_REFRESH_TOKEN=""

# Zernio - Social Media API (đăng bài TikTok/đa nền tảng qua 1 API). Chỉ dùng bởi
# scripts/test-zernio-tiktok.ts hiện tại, chưa nối vào luồng đăng bài chính (social-publishing).
# Lấy ở Dashboard Zernio > API Keys (định dạng sk_... 67 ký tự, chỉ hiện 1 lần)
ZERNIO_API_KEY="sk_xxxxxxxx"
ZERNIO_BASE_URL="https://zernio.com/api/v1"

# Token cho lenh goi server-to-server noi bo trong chinh BE
INTERNAL_API_TOKEN=change-me-to-a-long-random-string

# App Lark gửi thông báo — tách khỏi LARK_APP_ID ở trên
LARK_NOTIFY_APP_ID="your-notify-app-id"
LARK_NOTIFY_APP_SECRET="your-notify-app-secret"
# open_id người nhận báo cáo tuần (v1 gửi cho một người)
LARK_NOTIFY_OPEN_ID=""

# BẮT BUỘC khi bật báo cáo tuần. Không có giá trị mặc định trong code: để sẵn một cái thì
# môi trường quên cấu hình vẫn chạy được nhưng gửi sai chỗ mà không ai biết.
#   tài khoản quốc tế: https://open.larksuite.com/open-apis
#   tài khoản Trung Quốc (Feishu): https://open.feishu.cn/open-apis
LARK_API_BASE_URL=https://open.larksuite.com/open-apis

# Ngưỡng view để báo về Lark (bỏ trống = 1000000)
WEEKLY_REPORT_VIEW_THRESHOLD=1000000
# Bật cron 09:00. Để false cho tới khi duyệt xong nội dung message.
WEEKLY_REPORT_ENABLED=false

# Lark dashboard — tuning cache/concurrency (đều có mặc định trong code)
# LARK_ACTIVITY_ROLE_CACHE_TTL_MS=1800000
# LARK_ACTIVITY_SHARED_CACHE_TTL_MS=300000
# LARK_DASHBOARD_CONCURRENCY=3
# LARK_ENABLE_CHANNEL_SYNC=false

# Google OAuth dùng chung cho các luồng cũ (task-auto, v.v.) — có thể trùng GOOGLE_CLIENT_ID ở trên
OAUTH_CLIENT_ID="your-oauth-client-id"
OAUTH_CLIENT_SECRET="your-oauth-client-secret"
# Bí mật ký/băm token nội bộ social-publishing — đổi giá trị mặc định trước khi lên production
SOCIAL_TOKEN_SECRET="change-this-social-token-secret"

# Google Drive (COMPANY_DRIVE_PROVIDER=google) — nơi lưu video/asset dùng chung công ty
COMPANY_DRIVE_PROVIDER=google
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"
GOOGLE_DRIVE_PUBLIC=true
GOOGLE_DRIVE_REFRESH_TOKEN="your-google-drive-refresh-token"
GOOGLE_DRIVE_CLIENT_ID="your-google-drive-client-id"
GOOGLE_DRIVE_CLIENT_SECRET="your-google-drive-client-secret"
# Cách xác thực thay thế cho OAuth ở trên (google-drive-storage.service.ts) — chỉ cần MỘT trong ba
# biến dưới nếu chuyển sang Service Account, không dùng cùng lúc với OAuth phía trên.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# GOOGLE_DRIVE_USE_METADATA=true

# Supabase (service role - dùng cho các tính năng Supabase khác ngoài Postgres direct connection)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Web Push (VAPID) — dùng cho push notification module task-auto.
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:you@example.com"

MINIMAX_API_KEY="your-minimax-api-key"
# Quy doi diem MiniMax ra tien:
# - TTS model speech-2.8-hd: $100/1M ky tu (~2.600d/1.000 ky tu voi ty gia 26.000d/$)
# - TTS model speech-2.8-turbo: $60/1M ky tu (~1.500d/1.000 ky tu)
MINIMAX_VND_PER_1K_CHARS=2600
# Don gia clone 1 giong noi MiniMax ($1.50/voice -> ~38.000d/giong clone)
MINIMAX_VND_PER_CLONE=38000

# ==== Social Publishing OAuth (module social-publishing/oauth — luồng ĐĂNG bài lên MXH) ====
# Facebook — social-publishing/oauth/strategies/facebook.strategy.ts; Instagram flow "via_facebook"
# cũng dùng chung 2 biến này (KHÔNG phải FACEBOOK_APP_ID/SECRET ở dưới, đó là module khác).
# FB_APP_ID=
# FB_APP_SECRET=
# FB_REDIRECT_URI=      # để trống thì tự suy ra từ PUBLIC_BASE_URL/API_BASE_URL bên dưới

# Instagram flow "direct" — app Instagram riêng (KHÔNG dùng chung FB_APP_ID/SECRET ở trên).
# IG_APP_ID=
# IG_APP_SECRET=
# IG_REDIRECT_URI=

# YouTube — để trống 2 biến dưới thì tự dùng GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET đã khai báo ở trên.
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_REDIRECT_URI=

# Threads (Meta)
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# THREADS_REDIRECT_URI=

# Base URL công khai của BE — dùng để tự suy ra các *_REDIRECT_URI ở trên khi không set riêng.
# PUBLIC_BASE_URL="http://localhost:3000"
# API_BASE_URL="http://localhost:3000/api"
# FE_URL="http://localhost:3001"

# ==== Tracked-channels OAuth (module oauth/ — luồng LẤY dữ liệu kênh, khác social-publishing ở trên) ====
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_CALLBACK_URL=
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# TIKTOK_CALLBACK_URL=

# ==== Social publishing — tuning (đều có mặc định an toàn trong code, chỉ set khi cần đổi) ====
# SOCIAL_TOKEN_SALT=              # để trống thì dùng salt mặc định trong code kèm log cảnh báo
# SOCIAL_UPLOAD_DIR=              # mặc định uploads/social dưới thư mục chạy app
# SOCIAL_ACCOUNT_CONCURRENCY=1
# SOCIAL_TRANSCODE_CONCURRENCY=2
# SOCIAL_TRANSCODE_SKIP=false     # set false nếu video hay bị nền tảng từ chối vì tối ưu transcode
# TASK_PENDING_UPLOAD_DIR=        # mặc định uploads/task-pending dưới thư mục chạy app
# FFMPEG_PATH=
# FFPROBE_PATH=
