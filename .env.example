# Environment
NODE_ENV=development
PORT=3000

# Database (Supabase PgBouncer 6543: set DB_POOL_SIZE=5 max per Cloud Run instance)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
# DB_POOL_SIZE=5

# JWT Configuration
JWT_SECRET="your-secret-key-here"

# --- Auth cookie (xem docs/plans/2026-08-08-auth-cookie-httponly.md) ---
# Hạn access token. THAY HOÀN TOÀN JWT_EXPIRES_IN cũ — biến đó không còn được đọc ở đâu nữa.
# Sai định dạng (ví dụ "15x") thì app chết ngay lúc khởi động, có chủ đích.
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
# Production PHẢI đặt true, nếu không cookie đi qua HTTP trần.
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"
# Chỉ đặt khi FE/BE khác subdomain, ví dụ ".vcbi.vn". Để rỗng thì cookie gắn đúng host hiện tại.
COOKIE_DOMAIN=""
# Cửa sổ khoan dung cho tình huống hai tab cùng refresh một lúc. Dưới ngưỡng này, token vừa bị
# thu hồi mà được gửi lại sẽ được coi là đua tab chứ không phải bị trộm.
REFRESH_REUSE_GRACE_MS="30000"

# CORS
CORS_ORIGIN="http://localhost:3001"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
FRONTEND_URL="http://localhost:3001"

# AI Service Integration
AI_SERVICE_URL="http://localhost:8001"

# Search Service (Meilisearch)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="masterKey"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Lark Suite Configuration
LARK_APP_ID="your-lark-app-id"
LARK_APP_SECRET="your-lark-app-secret"

# Lark Bitable - Report Table
LARK_REPORT_BASE_ID="your-report-base-id"
LARK_REPORT_TABLE_ID="your-report-table-id"

# Lark Bitable - KPI & Employee Tables
LARK_KPI_BASE_ID="your-kpi-base-id"
LARK_KPI_TABLE_ID="your-kpi-table-id"
# KPI hiệu suất Đồ Da (wiki Bitable — mặc định trong code nếu để trống)
# KPI Do Da bot + bitable
LARK_KPI_DODA_APP_ID=""
LARK_KPI_DODA_APP_SECRET=""
LARK_KPI_DODA_BASE_ID=""
LARK_KPI_DODA_TABLE_ID=""
# KPI Global Indo - External wiki space, phai dung OAuth user token
LARK_KPI_GLOBAL_INDO_APP_ID=""
LARK_KPI_GLOBAL_INDO_APP_SECRET=""
LARK_KPI_GLOBAL_INDO_BASE_ID=""
LARK_KPI_GLOBAL_INDO_TABLE_ID=""
LARK_KPI_GLOBAL_INDO_REPORT_TABLE_ID=""
# Lay bang cach chay: npx ts-node scripts/lark-auth-global-indo.ts (tu gia han moi lan sync)
LARK_KPI_GLOBAL_INDO_REFRESH_TOKEN=""
LARK_EMPLOYEE_TABLE_ID="your-employee-table-id"

# Zernio - Social Media API (đăng bài TikTok/đa nền tảng qua 1 API)
# Lấy ở Dashboard Zernio > API Keys (định dạng sk_... 67 ký tự, chỉ hiện 1 lần)
ZERNIO_API_KEY="sk_xxxxxxxx"
ZERNIO_BASE_URL="https://zernio.com/api/v1"

# Token cho lenh goi server-to-server noi bo trong chinh BE
INTERNAL_API_TOKEN=change-me-to-a-long-random-string

# App Lark gửi thông báo — tách khỏi LARK_APP_ID ở trên
LARK_NOTIFY_APP_ID="your-notify-app-id"
LARK_NOTIFY_APP_SECRET="your-notify-app-secret"
# open_id người nhận báo cáo tuần (v1 gửi cho một người)
LARK_NOTIFY_OPEN_ID=""

# Ngưỡng view để báo về Lark (bỏ trống = 1000000)
BAO_CAO_TUAN_NGUONG_VIEW=1000000
# Bật cron 09:00. Để false cho tới khi duyệt xong nội dung tin.
BAO_CAO_TUAN_BAT=false

# MiniMax — TTS + clone giọng (trang Tiện ích > Clone Voice)
# Key giữ Ở ĐÂY, không để trong .env của AI service: BE gửi kèm từng request voice
# sang AI qua header X-Minimax-Key. Thiếu key thì cả TTS lẫn clone đều lỗi.
# Key kiểu mới "sk-api-..." tự gắn với group, KHÔNG cần MINIMAX_GROUP_ID.
MINIMAX_API_KEY="sk-api-xxxxxxxx"
# Đơn giá quy đổi "điểm âm thanh" ra tiền: VND cho mỗi 1.000 ký tự tính phí.
# VD gói 250.000đ / 500.000 ký tự -> 500. Để 0 nếu chưa biết giá.
MINIMAX_VND_PER_1K_CHARS=0
# Chỉ set khi cần trỏ riêng các endpoint /api/voice/* sang một AI service khác.
# Bỏ trống: chạy trên Railway -> tự dùng private network automationgenvideo-ai,
# chạy local -> dùng chung AI_SERVICE_URL ở trên.
AI_SERVICE_URL_VOICE=""
# BẮT BUỘC khi BE chạy trên Railway, nếu không voice sẽ đi qua AI_SERVICE_URL
# (tunnel máy local, có thể đang tắt) và BE ghi cảnh báo vào log.
# Lấy giá trị: Railway > service AI > Variables > private domain, kèm PORT service đó
# thực nhận (Dockerfile.railway bind gunicorn vào ${PORT}, KHÔNG cố định 8080).
AI_SERVICE_VOICE_RAILWAY_URL=""
